<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Hisa.App"
        xmlns:cards="clr-namespace:Hisa.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="Hisa.App.MiningCharacterBreakdownWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mining Character Breakdown"
        Width="1180"
        Height="760"
        MinWidth="1000"
        MinHeight="420"
        Background="#0D131D">
  <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="12">
    <Border Grid.Row="0"
            Padding="14"
            CornerRadius="10"
            Background="#131D2B"
            BorderBrush="#32425C"
            BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel>
          <TextBlock Text="Per Character Breakdown" FontSize="20" FontWeight="SemiBold" Foreground="#F3F7FF" />
          <TextBlock Text="{Binding MiningWindowStatus}" Foreground="#93A8C0" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="{Binding MiningStatsCards.Count, StringFormat={}{0} characters}"
                   Foreground="#8EC8A2"
                   FontSize="12"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Right" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <ItemsControl ItemsSource="{Binding MiningStatsCards}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="cards:MiningStatsCard">
              <Border Padding="10" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Width="44"
                            Height="44"
                            Background="#0B111A"
                            CornerRadius="8"
                            BorderBrush="#2B3C55"
                            BorderThickness="1">
                      <Grid>
                        <Image Source="{Binding PortraitBitmap}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding HasPortraitBitmap}" />
                        <TextBlock Text="{Binding PortraitFallbackText}"
                                   Foreground="#DDEAFF"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding HasNoPortraitBitmap}" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding CharacterName}" Foreground="#F3F7FF" FontWeight="SemiBold" FontSize="15" />
                        <Border Background="#1B2737" BorderBrush="#2B3C55" BorderThickness="1" CornerRadius="4" Padding="6,1">
                          <TextBlock Text="{Binding CharacterId}" Foreground="#C9D9EE" FontSize="11" />
                        </Border>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding PrimaryOreName}" Foreground="#8EC8A2" FontSize="12" />
                        <TextBlock Text="{Binding SessionAgeSummary}" Foreground="#93A8C0" FontSize="11" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                      <Border Background="#182333" BorderBrush="#2C405F" BorderThickness="1" CornerRadius="5" Padding="8,4">
                        <TextBlock Text="{Binding IskRateSummary}" Foreground="#F2FFE8" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Text="{Binding LastUpdatedSummary}" Foreground="#7F93AE" FontSize="11" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Background="#172234" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="10" Padding="12">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Combined Mining Rate" Foreground="#7F93AE" FontSize="11" />
                        <TextBlock Text="{Binding TotalMiningRateSummary}" Foreground="#F4FAFF" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EfficiencySummary}" Foreground="#9AB5D3" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#162635" BorderBrush="#2A4A63" BorderThickness="1" CornerRadius="10" Padding="12">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Yield" Foreground="#7F93AE" FontSize="11" />
                        <TextBlock Text="{Binding MiningRateSummary}" Foreground="#F0F7FF" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SessionTotalSummary}" Foreground="#9AB5D3" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#231A1A" BorderBrush="#5D3E3E" BorderThickness="1" CornerRadius="10" Padding="12">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Waste" Foreground="#C79F9F" FontSize="11" />
                        <TextBlock Text="{Binding WasteRateSummary}" Foreground="#FFE4E4" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding WasteIskRateSummary}" Foreground="#D8BBBB" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Border Background="#101A28" BorderBrush="#223247" BorderThickness="1" CornerRadius="10" Padding="10">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Mined" Foreground="#93A8C0" FontSize="11" />
                        <TextBlock Text="{Binding TotalMinedSummary}" Foreground="#F3F7FF" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#101A28" BorderBrush="#223247" BorderThickness="1" CornerRadius="10" Padding="10">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Value" Foreground="#93A8C0" FontSize="11" />
                        <TextBlock Text="{Binding TotalEstimatedIskSummary}" Foreground="#CFF5C6" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#101A28" BorderBrush="#223247" BorderThickness="1" CornerRadius="10" Padding="10">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Waste" Foreground="#93A8C0" FontSize="11" />
                        <TextBlock Text="{Binding WasteTotalSummary}" Foreground="#F8D3D3" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="#101A28" BorderBrush="#223247" BorderThickness="1" CornerRadius="10" Padding="10">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Waste Loss" Foreground="#93A8C0" FontSize="11" />
                        <TextBlock Text="{Binding TotalWasteIskSummary}" Foreground="#F3C0C0" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <Border Background="#162131" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="10" Padding="12,7">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Efficiency" Foreground="#7F93AE" FontSize="11" />
                        <TextBlock Text="{Binding EfficiencyPercentSummary}" Foreground="#F0F7FF" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#162131" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="10" Padding="12,7">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Yield %" Foreground="#7F93AE" FontSize="11" />
                        <TextBlock Text="{Binding YieldPercentSummary}" Foreground="#F0F7FF" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#162131" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="10" Padding="12,7">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Crit %" Foreground="#7F93AE" FontSize="11" />
                        <TextBlock Text="{Binding CritPercentSummary}" Foreground="#F0F7FF" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="#231A1A" BorderBrush="#5D3E3E" BorderThickness="1" CornerRadius="10" Padding="12,7">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Waste %" Foreground="#C79F9F" FontSize="11" />
                        <TextBlock Text="{Binding WastePercentSummary}" Foreground="#FFE4E4" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Background="#0F1622" BorderBrush="#223247" BorderThickness="1" CornerRadius="10" Padding="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <TextBlock Text="Ore Mix" Foreground="#93A8C0" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding OreMixSummary}" Foreground="#DCE8F8" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border IsVisible="{Binding HasNoMiningStats}"
                Padding="16"
                CornerRadius="10"
                Background="#101826"
                BorderBrush="#243247"
                BorderThickness="1">
          <TextBlock Text="No mining stats are available for the selected range yet."
                     Foreground="#93A8C0"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
