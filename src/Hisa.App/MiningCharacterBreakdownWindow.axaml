<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Hisa.App"
        xmlns:cards="clr-namespace:Hisa.App.ViewModels"
        x:Class="Hisa.App.MiningCharacterBreakdownWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mining Character Breakdown"
        Width="920" Height="680"
        MinWidth="840" MinHeight="420"
        Background="#0D131D">
  <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="10">
    <Border Padding="14,12" CornerRadius="10" Background="#131D2B" BorderBrush="#32425C" BorderThickness="1">
      <StackPanel Spacing="2">
        <TextBlock Text="Character Breakdown" FontSize="20" FontWeight="SemiBold" Foreground="#F3F7FF" />
        <TextBlock Text="{Binding MiningWindowStatus}" Foreground="#A4B7CE" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ListBox Grid.Row="1" ItemsSource="{Binding MiningStatsCards}" IsVisible="{Binding HasMiningStats}"
             Background="Transparent" BorderThickness="0" Padding="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="cards:MiningStatsCard">
          <vm:MiningStatsCardView Margin="0,0,0,8" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="1" IsVisible="{Binding HasNoMiningStats}" VerticalAlignment="Top" Padding="14"
            CornerRadius="10" Background="#101826" BorderBrush="#243247" BorderThickness="1">
      <TextBlock Text="No mining stats are available for the selected range yet."
                 Foreground="#A4B7CE" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
