<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
        x:Class="Hisa.App.AlertsSettingsWindow"
        Title="Alerts Settings"
        MinWidth="920"
        MinHeight="620"
        Width="980"
        Height="640"
        Background="#0D131D">
  <Grid Margin="10" ColumnDefinitions="260,*" ColumnSpacing="10">
    <Border Grid.Column="0" Background="#121A26" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="8" Padding="10">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="2">
          <TextBlock Text="Alert Rules" Foreground="#EAF2FF" FontWeight="SemiBold"/>
          <TextBlock Text="Higher rules win ties; tighter distance rules win first." Foreground="#9DB8D8" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
        <ListBox Grid.Row="1" x:Name="RulesListBox" Margin="0,8,0,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectionChanged="OnRuleSelectionChanged"/>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
          <Button Grid.Column="0" Content="Add" Click="OnAddRuleClicked"/>
          <Button Grid.Column="1" Content="Delete" Click="OnDeleteRuleClicked"/>
          <Button Grid.Row="1" Grid.Column="0" Content="Move Up" Click="OnMoveRuleUpClicked"/>
          <Button Grid.Row="1" Grid.Column="1" Content="Move Down" Click="OnMoveRuleDownClicked"/>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="1" Background="#121A26" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="8" Padding="10">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Rule Editor" Foreground="#EAF2FF" FontWeight="SemiBold"/>
        <ScrollViewer Grid.Row="1" Margin="0,8,0,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Grid.Column="0" x:Name="RuleNameTextBox" Watermark="Rule name" MinWidth="220"/>
              <CheckBox Grid.Column="1" x:Name="RuleEnabledCheckBox" Content="Enabled" Foreground="#DDE7F8" VerticalAlignment="Center"/>
            </Grid>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="Event" Foreground="#9DB8D8"/>
                <ComboBox x:Name="EventTypeComboBox" MinWidth="170" SelectionChanged="OnEditorValueChanged"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Scope" Foreground="#9DB8D8"/>
                <ComboBox x:Name="ScopeModeComboBox" MinWidth="170" SelectionChanged="OnEditorValueChanged"/>
              </StackPanel>
              <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="Distance Mode" Foreground="#9DB8D8"/>
                  <ComboBox x:Name="DistanceModeComboBox" MinWidth="170" SelectionChanged="OnEditorValueChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="1" x:Name="CooldownPanel" Spacing="3">
                  <TextBlock Text="Sound Cooldown (s)" Foreground="#9DB8D8"/>
                  <TextBox x:Name="CooldownSecondsTextBox" Width="110" Watermark="0"/>
                </StackPanel>
              </Grid>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Grid.Column="0" x:Name="CharacterSelectorPanel" Spacing="3">
                <TextBlock Text="Characters" Foreground="#9DB8D8"/>
                <Border Padding="6" CornerRadius="6" BorderBrush="#2A3C58" BorderThickness="1" Background="#0F1624">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <TextBox Grid.Column="0" x:Name="CharacterSearchTextBox" Watermark="Search character..." TextChanged="OnCharacterSearchTextChanged" KeyDown="OnCharacterSearchKeyDown"/>
                      <Button Grid.Column="1" Content="Add" MinWidth="60" Click="OnAddCharacterClicked"/>
                    </Grid>
                    <ListBox x:Name="CharacterCandidatesListBox" Height="106" DoubleTapped="OnCharacterCandidateDoubleTapped"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <ListBox Grid.Column="0" x:Name="SelectedCharactersListBox" Height="82" DoubleTapped="OnSelectedCharacterDoubleTapped"/>
                      <Button Grid.Column="1" Content="Remove" MinWidth="72" Click="OnRemoveCharacterClicked" VerticalAlignment="Top"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1" x:Name="MaxJumpsPanel" Spacing="3">
                <TextBlock Text="Max Jumps" Foreground="#9DB8D8"/>
                <TextBox x:Name="MaxJumpsTextBox" Width="92" Watermark="3"/>
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="14">
              <CheckBox Grid.Column="0" x:Name="IncludeAnsiblexCheckBox" Content="Use Ansiblex" Foreground="#DDE7F8"/>
              <CheckBox Grid.Column="1" x:Name="ActionSoundCheckBox" Content="Play Sound" Foreground="#DDE7F8" Checked="OnActionSoundToggleChanged" Unchecked="OnActionSoundToggleChanged"/>
              <CheckBox Grid.Column="2" x:Name="ShowClearIntelReportsCheckBox" Content="Show clear / CLR reports" Foreground="#DDE7F8"/>
            </Grid>

            <Border Padding="8" CornerRadius="6" BorderBrush="#2A3C58" BorderThickness="1" Background="#111A2A">
              <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Sound file" Foreground="#9DB8D8"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Volume %" Foreground="#9DB8D8"/>
                <Border Grid.RowSpan="2" Grid.Column="2" Background="Transparent">
                  <Button VerticalAlignment="Bottom" Content="Test" MinWidth="72" Click="OnTestSoundClicked"/>
                </Border>

                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="SoundFileComboBox" IsEditable="True" MinWidth="260"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SoundVolumeTextBox" Width="72" Text="100"/>
                <Slider Grid.Row="2" Grid.ColumnSpan="3" x:Name="SoundVolumeSlider" Minimum="0" Maximum="100" Value="100"/>
              </Grid>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
          <Button Grid.Column="0" Content="Apply" MinWidth="88" Click="OnApplyRuleClicked"/>
          <Button Grid.Column="1" Content="Save All" MinWidth="88" Click="OnSaveAllClicked"/>
          <Button Grid.Column="2" Content="Close" MinWidth="88" Click="OnCloseClicked"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
