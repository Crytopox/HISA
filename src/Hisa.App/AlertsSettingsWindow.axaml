<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="690"
        x:Class="Hisa.App.AlertsSettingsWindow"
        Title="Alert Rules"
        MinWidth="960" MinHeight="620" Width="1080" Height="690"
        Background="#0D131D">
  <Grid Margin="12" ColumnDefinitions="258,*" ColumnSpacing="12">
    <Border Grid.Column="0" Background="#121A26" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="10" Padding="10">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <StackPanel Spacing="2">
          <TextBlock Text="Alert Rules" Foreground="#EAF2FF" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Rules run from top to bottom when equally specific. Move rules to set tie priority." Foreground="#9DB8D8" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
        <ListBox Grid.Row="1" x:Name="RulesListBox" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectionChanged="OnRuleSelectionChanged"/>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
          <Button Grid.Column="0" Content="Add rule" Click="OnAddRuleClicked"/>
          <Button Grid.Column="1" Content="Delete" Click="OnDeleteRuleClicked"/>
          <Button Grid.Row="1" Grid.Column="0" Content="Move up" Click="OnMoveRuleUpClicked"/>
          <Button Grid.Row="1" Grid.Column="1" Content="Move down" Click="OnMoveRuleDownClicked"/>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="1" Background="#121A26" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="10" Padding="12">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="Rule details" Foreground="#EAF2FF" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Choose what should alert, where it matters, and how HISA should notify you." Foreground="#9DB8D8" FontSize="11"/>
          </StackPanel>
          <CheckBox Grid.Column="1" x:Name="RuleEnabledCheckBox" Content="Rule enabled" Foreground="#DDE7F8" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10" Margin="0,0,4,0">
            <TextBox x:Name="RuleNameTextBox" Watermark="Rule name" FontSize="15"/>

            <Border Padding="10" CornerRadius="8" BorderBrush="#2A3C58" BorderThickness="1" Background="#101927">
              <StackPanel Spacing="7">
                <TextBlock Text="Trigger" Foreground="#EAF2FF" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Event" Foreground="#9DB8D8" FontSize="11"/>
                    <ComboBox x:Name="EventTypeComboBox" SelectionChanged="OnEditorValueChanged"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Where this alert applies" Foreground="#9DB8D8" FontSize="11"/>
                    <ComboBox x:Name="ScopeModeComboBox" SelectionChanged="OnEditorValueChanged"/>
                  </StackPanel>
                </Grid>
                <Border Background="#0D1624" CornerRadius="5" Padding="6">
                  <TextBlock x:Name="ScopeHelpTextBlock" Foreground="#B6CAE5" FontSize="11" TextWrapping="Wrap"/>
                </Border>
              </StackPanel>
            </Border>

            <Border Padding="10" CornerRadius="8" BorderBrush="#2A3C58" BorderThickness="1" Background="#101927">
              <StackPanel Spacing="7">
                <TextBlock Text="Location filter" Foreground="#EAF2FF" FontWeight="SemiBold"/>
                <Grid x:Name="DistanceSettingsPanel" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Distance from the selected character reference" Foreground="#9DB8D8" FontSize="11"/>
                    <ComboBox x:Name="DistanceModeComboBox" SelectionChanged="OnEditorValueChanged"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" x:Name="MaxJumpsPanel" Spacing="4">
                    <TextBlock Text="Max jumps" Foreground="#9DB8D8" FontSize="11"/>
                    <TextBox x:Name="MaxJumpsTextBox" Width="100" Watermark="3"/>
                  </StackPanel>
                </Grid>

                <StackPanel x:Name="CharacterSelectorPanel" Spacing="5">
                  <TextBlock Text="Specific character references" Foreground="#9DB8D8" FontSize="11"/>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" x:Name="CharacterSearchTextBox" Watermark="Filter tracked characters…" TextChanged="OnCharacterSearchTextChanged" KeyDown="OnCharacterSearchKeyDown"/>
                    <Button Grid.Column="1" Content="Add" MinWidth="70" Click="OnAddCharacterClicked"/>
                    <Button Grid.Column="2" Content="Remove" MinWidth="76" Click="OnRemoveCharacterClicked"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <TextBlock Text="Matches" Foreground="#718BAF" FontSize="10"/>
                      <ListBox x:Name="CharacterCandidatesListBox" Height="128" DoubleTapped="OnCharacterCandidateDoubleTapped"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="Selected (double-click to remove)" Foreground="#718BAF" FontSize="10"/>
                      <ListBox x:Name="SelectedCharactersListBox" Height="128" DoubleTapped="OnSelectedCharacterDoubleTapped"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>

                <StackPanel x:Name="RegionSelectorPanel" Spacing="5">
                  <TextBlock Text="Regions" Foreground="#9DB8D8" FontSize="11"/>
                  <TextBlock Text="Add one or more regions. An alert triggers if the event occurs in any selected region." Foreground="#718BAF" FontSize="10" TextWrapping="Wrap"/>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" x:Name="RegionSearchTextBox" Watermark="Filter regions…" TextChanged="OnRegionSearchTextChanged" KeyDown="OnRegionSearchKeyDown"/>
                    <Button Grid.Column="1" Content="Add" MinWidth="70" Click="OnAddRegionClicked"/>
                    <Button Grid.Column="2" Content="Remove" MinWidth="76" Click="OnRemoveRegionClicked"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <TextBlock Text="Matches" Foreground="#718BAF" FontSize="10"/>
                      <ListBox x:Name="RegionCandidatesListBox" Height="150" DoubleTapped="OnRegionCandidateDoubleTapped"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="Selected (double-click to remove)" Foreground="#718BAF" FontSize="10"/>
                      <ListBox x:Name="SelectedRegionsListBox" Height="150" DoubleTapped="OnSelectedRegionDoubleTapped"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="IntelTextMatchPanel" Padding="10" CornerRadius="8" BorderBrush="#2A3C58" BorderThickness="1" Background="#101927">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="5">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Intel text match" Foreground="#EAF2FF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TextPatternTextBox" Watermark="Word, phrase, or regular expression"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Text matches take priority over general Intel rules." Foreground="#718BAF" FontSize="10" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="1" Grid.Column="2" x:Name="UseRegexCheckBox" Content="Use regex" Foreground="#DDE7F8"/>
              </Grid>
            </Border>

            <Border Padding="10" CornerRadius="8" BorderBrush="#2A3C58" BorderThickness="1" Background="#101927">
              <StackPanel Spacing="7">
                <TextBlock Text="Notification" Foreground="#EAF2FF" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="18">
                  <CheckBox Grid.Column="0" x:Name="ActionSoundCheckBox" Content="Play sound" Foreground="#DDE7F8" Checked="OnActionSoundToggleChanged" Unchecked="OnActionSoundToggleChanged"/>
                  <CheckBox Grid.Column="1" x:Name="IncludeAnsiblexCheckBox" Content="Use Ansiblex for jump range" Foreground="#DDE7F8"/>
                  <CheckBox Grid.Column="2" x:Name="ShowClearIntelReportsCheckBox" Content="Include clear / CLR reports" Foreground="#DDE7F8"/>
                </Grid>
                <Grid ColumnDefinitions="*,90,Auto" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Sound file" Foreground="#9DB8D8" FontSize="11"/>
                    <ComboBox x:Name="SoundFileComboBox" IsEditable="True"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Volume %" Foreground="#9DB8D8" FontSize="11"/>
                    <TextBox x:Name="SoundVolumeTextBox" Text="100"/>
                  </StackPanel>
                  <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Test sound" MinWidth="84" Click="OnTestSoundClicked"/>
                </Grid>
                <Slider x:Name="SoundVolumeSlider" Minimum="0" Maximum="100" Value="100"/>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                  <TextBlock Grid.Column="0" Text="Sound cooldown (seconds)" Foreground="#9DB8D8" FontSize="11" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" x:Name="CooldownSecondsTextBox" Width="100" HorizontalAlignment="Left" Watermark="0"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
          <Button Grid.Column="0" Content="Apply rule" MinWidth="100" Click="OnApplyRuleClicked"/>
          <Button Grid.Column="1" Content="Save all rules" MinWidth="112" Click="OnSaveAllClicked"/>
          <Button Grid.Column="3" Content="Close" MinWidth="88" Click="OnCloseClicked"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
