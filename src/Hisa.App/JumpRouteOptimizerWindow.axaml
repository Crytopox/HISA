<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:Hisa.App"
        mc:Ignorable="d"
        x:Class="Hisa.App.JumpRouteOptimizerWindow"
        Width="860"
        Height="620"
        Title="Jump Route Optimizer"
        Background="#0D131D">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="8">
    <StackPanel Spacing="2">
      <TextBlock Text="Jump Route Optimizer" Foreground="#D8E5F8" FontSize="14" FontWeight="SemiBold" />
      <TextBlock Text="Compute direct jump routes between many systems with max LY constraints."
                 Foreground="#8FA5C4" FontSize="11" />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,6,0,0" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="6">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
        <Grid ColumnDefinitions="Auto,70,Auto,54,Auto,150,Auto,150,*" ColumnSpacing="5">
          <TextBlock Grid.Column="0" Text="Max Jump (LY)" VerticalAlignment="Center" Foreground="#8FA5C4" />
          <TextBox Grid.Column="1" x:Name="MaxLyTextBox" Text="7.0" />
          <TextBlock Grid.Column="2" Text="Top Results" VerticalAlignment="Center" Foreground="#8FA5C4" />
          <TextBox Grid.Column="3" x:Name="TopResultsTextBox" Width="52" Text="5" />
          <TextBlock Grid.Column="4" Text="Start (opt)" VerticalAlignment="Center" Foreground="#8FA5C4" />
          <TextBox Grid.Column="5" x:Name="StartSystemTextBox" TextChanged="OnStartSystemTextChanged" />
          <TextBlock Grid.Column="6" Text="End (opt)" VerticalAlignment="Center" Foreground="#8FA5C4" />
          <TextBox Grid.Column="7" x:Name="EndSystemTextBox" TextChanged="OnEndSystemTextChanged" />
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
          <CheckBox x:Name="FollowInputOrderCheckBox" IsChecked="False" Content="Try to follow input order exactly" Foreground="#CFE4FF" FontSize="11.5" />
          <CheckBox x:Name="ReturnToStartCheckBox" Content="Return" VerticalAlignment="Center" />
          <Button Content="Analyze" Click="OnAnalyzeClicked" />
          <Button Content="Apply Selected To Map" Click="OnApplySelectedClicked" />
          <Button Content="Clear Map Route" Click="OnClearMapRouteClicked" />
        </StackPanel>
      </Grid>
    </Border>
    <Popup x:Name="StartSuggestionsPopup" PlacementTarget="{Binding #StartSystemTextBox}" Placement="Bottom" VerticalOffset="2" IsOpen="False">
      <Border Width="220" Background="#111926" BorderBrush="#2B3C55" BorderThickness="1" CornerRadius="4">
        <ListBox x:Name="StartSuggestionsListBox"
                 SelectionChanged="OnStartSuggestionSelected"
                 MaxHeight="220"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="#D8E5F8" />
      </Border>
    </Popup>
    <Popup x:Name="EndSuggestionsPopup" PlacementTarget="{Binding #EndSystemTextBox}" Placement="Bottom" VerticalOffset="2" IsOpen="False">
      <Border Width="220" Background="#111926" BorderBrush="#2B3C55" BorderThickness="1" CornerRadius="4">
        <ListBox x:Name="EndSuggestionsListBox"
                 SelectionChanged="OnEndSuggestionSelected"
                 MaxHeight="220"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="#D8E5F8" />
      </Border>
    </Popup>

    <Border Grid.Row="2" Margin="0,6,0,0" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="6">
      <StackPanel Spacing="4">
        <TextBlock Text="Target systems (space/comma/newline separated)" Foreground="#8FA5C4" FontSize="11" />
        <TextBox x:Name="InputSystemsTextBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Margin="0,6,0,0" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="6">
      <TextBlock Text="When enabled, the tool first attempts strict input order. If impossible, it will show alternatives and explain why."
                 Foreground="#8FA5C4" FontSize="11" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="4" Margin="0,6,0,0" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="5">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock x:Name="SummaryTextBlock" Foreground="#8FA5C4" Margin="0,0,0,4" FontSize="11" Text="Run analysis to see route candidates." />
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="#18263A" BorderBrush="#2C425F" BorderThickness="1" CornerRadius="4" Padding="5,4">
            <Grid ColumnDefinitions="200,62,62,62,170,*" ColumnSpacing="5">
              <TextBlock Grid.Column="0" Text="Route" Foreground="#CFE4FF" FontWeight="SemiBold" FontSize="11.5" />
              <TextBlock Grid.Column="1" Text="Visited" Foreground="#CFE4FF" FontWeight="SemiBold" FontSize="11.5" />
              <TextBlock Grid.Column="2" Text="Total LY" Foreground="#CFE4FF" FontWeight="SemiBold" FontSize="11.5" />
              <TextBlock Grid.Column="3" Text="Max Leg" Foreground="#CFE4FF" FontWeight="SemiBold" FontSize="11.5" />
              <TextBlock Grid.Column="4" Text="Skipped" Foreground="#CFE4FF" FontWeight="SemiBold" FontSize="11.5" />
              <TextBlock Grid.Column="5" Text="Reason" Foreground="#CFE4FF" FontWeight="SemiBold" FontSize="11.5" />
            </Grid>
          </Border>
          <ListBox Grid.Row="1" x:Name="CandidatesListBox" BorderThickness="0" Background="Transparent" Margin="0,4,0,0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="app:JumpRouteCandidateRow">
                <Grid ColumnDefinitions="200,62,62,62,170,*" ColumnSpacing="5" Margin="1">
                  <TextBlock Grid.Column="0" Text="{Binding RouteText}" Foreground="#D8E5F8" TextWrapping="Wrap" FontSize="11.5" />
                  <TextBlock Grid.Column="1" Text="{Binding VisitedText}" Foreground="#CFE4FF" VerticalAlignment="Center" FontSize="11.5" />
                  <TextBlock Grid.Column="2" Text="{Binding TotalDistanceLyText}" Foreground="#CFE4FF" VerticalAlignment="Center" FontSize="11.5" />
                  <TextBlock Grid.Column="3" Text="{Binding MaxLegLyText}" Foreground="#CFE4FF" VerticalAlignment="Center" FontSize="11.5" />
                  <TextBlock Grid.Column="4" Text="{Binding SkippedPreview}" Foreground="#AFC6E2" TextWrapping="Wrap" FontSize="11.5" />
                  <TextBlock Grid.Column="5" Text="{Binding SkippedReasonPreview}" Foreground="#94AAC8" TextWrapping="Wrap" FontSize="11.5" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <TextBlock Grid.Row="2" Margin="0,4,0,0" Foreground="#8FA5C4" FontSize="11"
                   Text="Map Legend: per-leg route colors show jump sequence, red rings = skipped systems." />
      </Grid>
    </Border>

    <Border Grid.Row="5" Margin="0,6,0,0" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="5">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Per-leg Breakdown" Foreground="#D8E5F8" FontWeight="SemiBold" FontSize="12" />
          <Button Content="Copy Selected Route" Click="OnCopySelectedRouteClicked" />
        </StackPanel>
        <TextBlock Grid.Row="1" Foreground="#8FA5C4" FontSize="11" Text="Select a result row to see per-leg sequence and distances." />
        <TextBox Grid.Row="2" x:Name="LegsBreakdownTextBox" AcceptsReturn="True" IsReadOnly="True" Height="86" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="6" x:Name="StatusTextBlock" Foreground="#8FA5C4" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
  </Grid>
</Window>
