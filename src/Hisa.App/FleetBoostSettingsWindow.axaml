<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hisa.App.FleetBoostSettingsWindow" Title="Boost Tracker Settings" Width="430" Height="360"
        MinWidth="380" MinHeight="320" Background="#0D131D">
  <Border Margin="10" Padding="14" Background="#121A26" BorderBrush="#263244" BorderThickness="1" CornerRadius="6">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
      <TextBlock Text="Fleet boost channels" FontSize="15" FontWeight="SemiBold" Foreground="#D8E5F8"/>
      <TextBlock Grid.Row="1" Text="One channel per line. Choose a channel in the tracker and click Start tracking. Uses the EVE logs folder in Preferences." TextWrapping="Wrap" FontSize="12" Foreground="#8A96A8"/>
      <TextBox Grid.Row="2" x:Name="ChannelsText" AcceptsReturn="True" Watermark="Fleet Boosts&#10;Alliance Fleet" VerticalContentAlignment="Top"/>
      <TextBlock Grid.Row="3" x:Name="Feedback" Foreground="#8A96A8" FontSize="11" TextWrapping="Wrap"/>
      <Button Grid.Row="4" x:Name="SaveButton" Content="Save" HorizontalAlignment="Right" MinWidth="90" Click="OnSave"/>
    </Grid>
  </Border>
</Window>
