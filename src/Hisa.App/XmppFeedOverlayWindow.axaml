<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hisa.App"
        x:Class="Hisa.App.XmppFeedOverlayWindow"
        Title="Notification Feed" Width="420" Height="560" MinWidth="300" MinHeight="220"
        SystemDecorations="None" CanResize="True" ShowActivated="True"
        ShowInTaskbar="False" Background="#101722">
  <Window.Styles>
    <Style Selector="Button.compact">
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#B9CCE3" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Styles>
  <Border BorderBrush="#304057" BorderThickness="1" CornerRadius="6">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" x:Name="DragHandle" Background="#172232" BorderBrush="#29394E"
              BorderThickness="0,0,0,1" Padding="8,4,4,4" Cursor="SizeAll"
              PointerPressed="OnHeaderPointerPressed">
        <Grid ColumnDefinitions="*,Auto,Auto" Background="Transparent">
          <TextBlock Text="NOTIFICATION FEED" FontSize="11" FontWeight="SemiBold"
                     Foreground="#E1EBF7" VerticalAlignment="Center" IsHitTestVisible="False" />
          <ToggleButton Grid.Column="1" x:Name="PinToggle" Content="Pin" FontSize="11"
                        Padding="6,1" MinHeight="18" IsCheckedChanged="OnPinChanged"
                        ToolTip.Tip="Keep on top" />
          <Button Grid.Column="2" Classes="compact" Content="×" FontSize="17"
                  Click="OnCloseClicked" ToolTip.Tip="Close" />
        </Grid>
      </Border>
      <ScrollViewer x:Name="FeedScroll" Grid.Row="1" Background="Transparent"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="FeedList" Margin="8,6,8,8">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="local:XmppFeedCardVm">
              <local:XmppFeedCardView ShowFeedActions="True"
                                      LinkActivated="OnCardLinkActivated"
                                      OpenMessageClick="OnOpenMessage"
                                      CopyRawClick="OnCopyRaw"
                                      OpenMumbleClick="OnOpenMumble"
                                      ShowOnMapClick="OnShowOnMap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="#29394E" BorderThickness="0,1,0,0" Padding="6,3,3,3">
        <Grid ColumnDefinitions="*,Auto">
          <Border Grid.Column="1" Width="20" Height="18" Background="Transparent"
                  Tag="SouthEast" PointerPressed="OnResizePointerPressed"
                  Cursor="BottomRightCorner" ToolTip.Tip="Resize">
            <TextBlock Text="◢" Foreground="#687F9E" FontSize="12" />
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
