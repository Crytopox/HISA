<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Hisa.App.ViewModels"
        x:Class="Hisa.App.MiningSitesWindow" Width="620" Height="700"
        Title="Mining Sites Tracker" Background="#0D131D">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="10">
    <StackPanel Spacing="4">
      <TextBlock Text="Mining Sites Tracker" Foreground="#EAF2FF" FontSize="17" FontWeight="SemiBold" />
      <TextBlock Text="Cleared uses the exact T1/T2/T3 respawn delay. Missing can be configured manually." Foreground="#91A6C2" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,0">
        <TextBlock Text="Missing reminder" Foreground="#B8C9DE" VerticalAlignment="Center" />
        <ComboBox x:Name="ReminderPresetCombo" Width="100" SelectedIndex="1"><ComboBoxItem Content="3 hours"/><ComboBoxItem Content="5 hours"/><ComboBoxItem Content="8 hours"/><ComboBoxItem Content="11 hours"/></ComboBox>
        <TextBox x:Name="CustomHoursBox" Width="115" Watermark="Custom hours" />
        <TextBlock Text="Show" Foreground="#B8C9DE" VerticalAlignment="Center" />
        <ComboBox x:Name="StatusFilterCombo" Width="110" SelectedIndex="0" SelectionChanged="OnStatusFilterChanged">
          <ComboBoxItem Content="All" />
          <ComboBoxItem Content="Available" />
          <ComboBoxItem Content="Missing" />
          <ComboBoxItem Content="Cleared" />
          <ComboBoxItem Content="Missing + Cleared" />
        </ComboBox>
        <Button Content="Refresh" Click="OnRefreshClicked" />
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="1" Background="#101826" BorderBrush="#263B56" BorderThickness="1" CornerRadius="5" Padding="7">
      <ListBox x:Name="ReportsList" Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MiningSiteReportRow">
            <Grid ColumnDefinitions="*,145,165" RowDefinitions="Auto,Auto" Margin="3,6">
              <StackPanel Grid.Column="0" Spacing="1">
                <TextBlock Text="{Binding SystemName}" Foreground="#EAF2FF" FontWeight="SemiBold" />
                <TextBlock Foreground="#B2C5DD"><Run Text="{Binding UpgradeName}"/><Run Text=" T"/><Run Text="{Binding Tier}"/></TextBlock>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DueText}" Foreground="#879BB4" FontSize="11" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Content="Cleared" Click="OnClearedClicked" FontSize="11" />
                <Button Content="Missing" Click="OnMissingClicked" FontSize="11" />
                <Button Content="Ready" Click="OnReadyClicked" FontSize="11" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#91A6C2" TextWrapping="Wrap" />
  </Grid>
</Window>
