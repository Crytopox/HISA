<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Hisa.App"
        xmlns:converters="clr-namespace:Hisa.App.Converters"
        x:Class="Hisa.App.MiningStatsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mining Stats"
        Width="920" Height="480"
        MinWidth="840" MinHeight="440"
        Background="#0D131D">
  <Window.Resources>
    <converters:MiningRangeModeDisplayConverter x:Key="MiningRangeModeDisplayConverter" />
    <converters:MiningOverlayRangeModeDisplayConverter x:Key="MiningOverlayRangeModeDisplayConverter" />
  </Window.Resources>
  <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="10">
    <Border Padding="14,12" CornerRadius="10" Background="#131D2B" BorderBrush="#32425C" BorderThickness="1">
      <StackPanel Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Text="Live Mining Sessions" FontSize="20" FontWeight="SemiBold" Foreground="#F3F7FF" />
          <TextBlock Text="{Binding MiningWindowStatus}" Foreground="#A4B7CE" TextWrapping="Wrap" />
        </StackPanel>
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ComboBox Width="162"
                      AutomationProperties.Name="Stats range"
                      ItemsSource="{Binding MiningRangeModes}"
                      SelectedItem="{Binding SelectedMiningRangeMode}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource MiningRangeModeDisplayConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Refresh" Click="OnRefreshClicked" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Label Target="{Binding #RefineYieldInput}" Content="Refine yield (%)" Padding="0" VerticalAlignment="Center" />
            <TextBox x:Name="RefineYieldInput" Width="72" Text="{Binding MiningRefineYieldPercentText, Mode=TwoWay}" />
            <Button Content="Apply" Click="OnApplyRefineYieldClicked" />
          </StackPanel>
          <Button Grid.Column="3" Content="Character Breakdown" Click="OnOpenCharacterBreakdownClicked" />
        </Grid>
        <Border BorderBrush="#2A3C53" BorderThickness="0,1,0,0" Padding="0,10,0,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Overlay range" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Width="144"
                      AutomationProperties.Name="Overlay range"
                      ItemsSource="{Binding MiningOverlayRangeModes}"
                      SelectedItem="{Binding SelectedMiningOverlayRangeMode}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource MiningOverlayRangeModeDisplayConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="{Binding MiningOverlayToggleLabel}" Click="OnToggleOverlayClicked" />
            <Button Content="Reset Position" Click="OnResetOverlayPositionClicked" IsEnabled="{Binding IsMiningOverlayVisible}" />
            <Button Content="Overlay Settings">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft" Closed="OnOverlaySettingsClosed">
                  <StackPanel Width="254" Spacing="10">
                    <CheckBox Content="Show when inactive" IsChecked="{Binding ShowMiningOverlayWhenInactive, Mode=TwoWay}" />
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                      <TextBlock Text="Text opacity" />
                      <TextBlock Grid.Column="1" Text="{Binding MiningOverlayTextOpacityPercent, StringFormat={}{0:0}%}" />
                      <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="20" Maximum="100" TickFrequency="1"
                              AutomationProperties.Name="Text opacity" IsSnapToTickEnabled="True"
                              Value="{Binding MiningOverlayTextOpacityPercent, Mode=TwoWay}" />
                    </Grid>
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                      <TextBlock Text="Background and border opacity" />
                      <TextBlock Grid.Column="1" Text="{Binding MiningOverlayFrameOpacityPercent, StringFormat={}{0:0}%}" />
                      <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="20" Maximum="100" TickFrequency="1"
                              AutomationProperties.Name="Background and border opacity" IsSnapToTickEnabled="True"
                              Value="{Binding MiningOverlayFrameOpacityPercent, Mode=TwoWay}" />
                    </Grid>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Panel>
        <Panel IsVisible="{Binding HasAggregateMiningStats}">
          <vm:MiningStatsCardView DataContext="{Binding AggregateMiningStatsCard}" VerticalAlignment="Top" />
        </Panel>
        <Border IsVisible="{Binding HasNoMiningStats}" VerticalAlignment="Top" Padding="14" CornerRadius="10"
                Background="#101826" BorderBrush="#243247" BorderThickness="1">
          <TextBlock Text="No mining stats are available for the selected range yet."
                     Foreground="#A4B7CE" TextWrapping="Wrap" />
        </Border>
      </Panel>
    </ScrollViewer>
  </Grid>
</Window>
