<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Hisa.App"
        xmlns:converters="clr-namespace:Hisa.App.Converters"
        xmlns:rendering="clr-namespace:Hisa.Rendering.Controls;assembly=Hisa.Rendering"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="Hisa.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="HISA - Haakario Interstellar Survey Authority"
        Icon="avares://Hisa.App/Assets/HISA-Logo.ico"
        Background="#0D131D">
  <Window.Resources>
    <converters:MapCoordinateModeDisplayConverter x:Key="MapCoordinateModeDisplayConverter" />
    <converters:MapNodeColorModeDisplayConverter x:Key="MapNodeColorModeDisplayConverter" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="ToggleButton.view-mode">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="#182333" />
      <Setter Property="BorderBrush" Value="#2B3C55" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#C4D4EA" />
    </Style>
    <Style Selector="ToggleButton.view-mode:checked">
      <Setter Property="Background" Value="#2E4664" />
      <Setter Property="BorderBrush" Value="#5D83B5" />
      <Setter Property="Foreground" Value="#EAF2FF" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="10,10" Background="#121A26" BorderBrush="#263244" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
            ColumnSpacing="12"
            VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,0,8,0">
            <ToggleButton Classes="view-mode" Content="Universe" IsChecked="{Binding IsUniverseMode, Mode=TwoWay}" />
            <ToggleButton Classes="view-mode" Content="Regions" IsChecked="{Binding IsUniverseRegionsMode, Mode=TwoWay}" />
            <ToggleButton Classes="view-mode" Content="Region" IsChecked="{Binding IsRegionMode, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsCoordinateSelectorVisible}">
          <TextBlock VerticalAlignment="Center" Text="ViewMode" Foreground="#8A96A8" />
          <ComboBox Width="190" ItemsSource="{Binding CoordinateModes}" SelectedItem="{Binding SelectedCoordinateMode}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource MapCoordinateModeDisplayConverter}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsRegionSelectorVisible}">
          <TextBlock VerticalAlignment="Center" Text="Region" Foreground="#8A96A8" />
          <ComboBox Width="220" ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" Text="Search" Foreground="#8A96A8" />
          <TextBox Width="280"
                   x:Name="MapSearchBox"
                   Text="{Binding MapSearchText}"
                   Watermark="{Binding SearchWatermark}"
                   GotFocus="OnSearchBoxGotFocus"
                   KeyDown="OnSearchKeyDown" />
        </StackPanel>
        <Popup PlacementTarget="{Binding #MapSearchBox}"
               Placement="Bottom"
               VerticalOffset="2"
               IsOpen="{Binding HasSearchSuggestions}">
          <Border Width="320"
                  Background="#111926"
                  BorderBrush="#2B3C55"
                  BorderThickness="1"
                  CornerRadius="4">
            <ListBox ItemsSource="{Binding SearchSuggestions}"
                     SelectedItem="{Binding SelectedSearchSuggestion, Mode=TwoWay}"
                     SelectionChanged="OnSearchSuggestionSelected"
                     MaxHeight="240"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#D8E5F8" />
          </Border>
        </Popup>
        <Button Grid.Column="5" Content="Fit / Center" Click="OnFitCenterClicked" MinWidth="96" />
        <ToggleButton Grid.Column="6" Content="Display" IsChecked="{Binding IsDisplaySettingsOpen, Mode=TwoWay}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <rendering:MapControl Grid.Column="0"
                            x:Name="MainMapControl"
                            Graph="{Binding CurrentGraph}"
                            ViewMode="{Binding SelectedViewMode}"
                            StretchToWindow="{Binding StretchMapToWindow}"
                            NodeColorMode="{Binding NodeColorMode}"
                            NodeBackgroundColorMode="{Binding NodeBackgroundColorMode}"
                            ShowIndicatorLabelText="{Binding ShowIndicatorLabelText}"
                            ShowIndicatorGlyph="{Binding ShowIndicatorGlyph}"
                            ShowIndicatorSecurityStatus="{Binding ShowIndicatorSecurityStatus}"
                            InfoBoxShowRegion="{Binding InfoBoxShowRegion}"
                            InfoBoxShowConstellation="{Binding InfoBoxShowConstellation}"
                            InfoBoxShowSystemId="{Binding InfoBoxShowSystemId}"
                            InfoBoxShowSecurityStatus="{Binding InfoBoxShowSecurityStatus}"
                            SelectedNodeId="{Binding SelectedNodeId, Mode=TwoWay}" />

      <Border Grid.Column="1"
              Width="300"
              Background="#121A26"
              BorderBrush="#263244"
              BorderThickness="1,0,0,0"
              Padding="10"
              IsVisible="{Binding IsDisplaySettingsOpen}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <TextBlock Text="Display Settings" FontSize="14" FontWeight="SemiBold" Foreground="#D8E5F8" />

            <TextBlock Text="Node Color" Foreground="#8A96A8" />
            <ComboBox ItemsSource="{Binding NodeColorModes}" SelectedItem="{Binding NodeColorMode}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource MapNodeColorModeDisplayConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Node Background Color" Foreground="#8A96A8" />
            <ComboBox ItemsSource="{Binding NodeColorModes}" SelectedItem="{Binding NodeBackgroundColorMode}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource MapNodeColorModeDisplayConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Indicators" Foreground="#8A96A8" />
            <CheckBox IsChecked="{Binding ShowIndicatorLabelText}" Content="Name" />
            <CheckBox IsChecked="{Binding ShowIndicatorGlyph}" Content="Show Glyph Marker" />
            <CheckBox IsChecked="{Binding ShowIndicatorSecurityStatus}" Content="Security Status" />

            <Separator />

            <TextBlock Text="Overlay Fields" Foreground="#8A96A8" />
            <CheckBox IsChecked="{Binding InfoBoxShowSecurityStatus}" Content="Security Status" />
            <CheckBox IsChecked="{Binding InfoBoxShowRegion}" Content="Show Region" />
            <CheckBox IsChecked="{Binding InfoBoxShowConstellation}" Content="Show Constellation" />
            <CheckBox IsChecked="{Binding InfoBoxShowSystemId}" Content="Show System ID" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2" Padding="8" Background="#121A26" BorderThickness="0">
      <TextBlock Text="{Binding StatusText}" Foreground="#8A96A8" />
    </Border>
  </Grid>
</Window>
