<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Hisa.App"
        xmlns:converters="clr-namespace:Hisa.App.Converters"
        xmlns:rendering="clr-namespace:Hisa.Rendering.Controls;assembly=Hisa.Rendering"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="Hisa.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="HISA - Haakario Interstellar Survey Authority"
        Background="#0D131D">
  <Window.Resources>
    <converters:MapCoordinateModeDisplayConverter x:Key="MapCoordinateModeDisplayConverter" />
  </Window.Resources>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="8,10" Background="#121A26" BorderBrush="#263244" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,160,Auto,190,Auto,220,Auto,220,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="View" Foreground="#8A96A8" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding SelectedViewMode}" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Coordinates" Foreground="#8A96A8" />
        <ComboBox Grid.Column="3" ItemsSource="{Binding CoordinateModes}" SelectedItem="{Binding SelectedCoordinateMode}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource MapCoordinateModeDisplayConverter}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Region Search" Foreground="#8A96A8" />
        <TextBox Grid.Column="5" Text="{Binding RegionSearchText}" Watermark="Type region name..." />
        <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="Region" Foreground="#8A96A8" />
        <ComboBox Grid.Column="7" ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}" />
        <Button Grid.Column="9" Content="Fit / Center" Click="OnFitCenterClicked" MinWidth="96" />
      </Grid>
    </Border>

    <rendering:MapControl Grid.Row="1"
                          x:Name="MainMapControl"
                          Graph="{Binding CurrentGraph}"
                          SelectedNodeId="{Binding SelectedNodeId, Mode=TwoWay}" />

    <Border Grid.Row="2" Padding="8" Background="#121A26" BorderThickness="0">
      <TextBlock Text="{Binding StatusText}" Foreground="#8A96A8" />
    </Border>
  </Grid>
</Window>

