<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Hisa.App"
        xmlns:converters="clr-namespace:Hisa.App.Converters"
        xmlns:rendering="clr-namespace:Hisa.Rendering.Controls;assembly=Hisa.Rendering"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="Hisa.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="HISA - Haakario Interstellar Survey Authority"
        Background="#0D131D">
  <Window.Resources>
    <converters:MapCoordinateModeDisplayConverter x:Key="MapCoordinateModeDisplayConverter" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="ToggleButton.view-mode">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="#182333" />
      <Setter Property="BorderBrush" Value="#2B3C55" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#C4D4EA" />
    </Style>
    <Style Selector="ToggleButton.view-mode:checked">
      <Setter Property="Background" Value="#2E4664" />
      <Setter Property="BorderBrush" Value="#5D83B5" />
      <Setter Property="Foreground" Value="#EAF2FF" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="8,10" Background="#121A26" BorderBrush="#263244" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="220,Auto,190,Auto,220,Auto,220,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0">
            <ToggleButton Classes="view-mode" Content="Universe" IsChecked="{Binding IsUniverseMode, Mode=TwoWay}" />
            <ToggleButton Classes="view-mode" Content="Regions" IsChecked="{Binding IsUniverseRegionsMode, Mode=TwoWay}" />
            <ToggleButton Classes="view-mode" Content="Region" IsChecked="{Binding IsRegionMode, Mode=TwoWay}" />
        </StackPanel>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Coordinates" Foreground="#8A96A8" IsVisible="{Binding IsCoordinateSelectorVisible}" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding CoordinateModes}" SelectedItem="{Binding SelectedCoordinateMode}" IsVisible="{Binding IsCoordinateSelectorVisible}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource MapCoordinateModeDisplayConverter}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Region Search" Foreground="#8A96A8" />
        <TextBox Grid.Column="4" Text="{Binding RegionSearchText}" Watermark="Type region name..." />
        <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="Region" Foreground="#8A96A8" />
        <ComboBox Grid.Column="6" ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}" />
        <Button Grid.Column="8" Content="Fit / Center" Click="OnFitCenterClicked" MinWidth="96" />
      </Grid>
    </Border>

    <rendering:MapControl Grid.Row="1"
                          x:Name="MainMapControl"
                          Graph="{Binding CurrentGraph}"
                          ViewMode="{Binding SelectedViewMode}"
                          SelectedNodeId="{Binding SelectedNodeId, Mode=TwoWay}" />

    <Border Grid.Row="2" Padding="8" Background="#121A26" BorderThickness="0">
      <TextBlock Text="{Binding StatusText}" Foreground="#8A96A8" />
    </Border>
  </Grid>
</Window>
