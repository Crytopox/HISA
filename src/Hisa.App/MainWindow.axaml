<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Hisa.App"
        xmlns:converters="clr-namespace:Hisa.App.Converters"
        xmlns:rendering="clr-namespace:Hisa.Rendering.Controls;assembly=Hisa.Rendering"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="Hisa.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="HISA - Haakario Interstellar Survey Authority"
        Icon="avares://Hisa.App/Assets/HISA-Logo.ico"
        Background="#0D131D">
  <Window.Resources>
    <converters:MapCoordinateModeDisplayConverter x:Key="MapCoordinateModeDisplayConverter" />
    <converters:MapNodeColorModeDisplayConverter x:Key="MapNodeColorModeDisplayConverter" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="ToggleButton.view-mode">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="#182333" />
      <Setter Property="BorderBrush" Value="#2B3C55" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#C4D4EA" />
    </Style>
    <Style Selector="ToggleButton.view-mode:checked">
      <Setter Property="Background" Value="#2E4664" />
      <Setter Property="BorderBrush" Value="#5D83B5" />
      <Setter Property="Foreground" Value="#EAF2FF" />
    </Style>
    <Style Selector="ContextMenu.map-node-menu">
      <Setter Property="Background" Value="#EC0A0D12" />
      <Setter Property="BorderBrush" Value="#7FB8DCFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ContextMenu.map-node-menu MenuItem.map-node-menu-item">
      <Setter Property="Foreground" Value="#EAF3FF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ContextMenu.map-node-menu MenuItem.map-node-menu-item:pointerover">
      <Setter Property="Background" Value="#4C8EC9FF" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ContextMenu.map-node-menu MenuItem.map-node-menu-item:pressed">
      <Setter Property="Background" Value="#6695CCFF" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="10,10" Background="#121A26" BorderBrush="#263244" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto"
            ColumnSpacing="12"
            VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,0,8,0">
            <ToggleButton Classes="view-mode" Content="Universe" IsChecked="{Binding IsUniverseMode, Mode=TwoWay}" />
            <ToggleButton Classes="view-mode" Content="Regions" IsChecked="{Binding IsUniverseRegionsMode, Mode=TwoWay}" />
            <ToggleButton Classes="view-mode" Content="Region" IsChecked="{Binding IsRegionMode, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsCoordinateSelectorVisible}">
          <ComboBox Width="190" ItemsSource="{Binding CoordinateModes}" SelectedItem="{Binding SelectedCoordinateMode}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource MapCoordinateModeDisplayConverter}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsRegionSelectorVisible}">
          <TextBlock VerticalAlignment="Center" Text="Region" Foreground="#8A96A8" />
          <ComboBox Width="260" ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBox Width="280"
                   x:Name="MapSearchBox"
                   Text="{Binding MapSearchText}"
                   Watermark="{Binding SearchWatermark}"
                   GotFocus="OnSearchBoxGotFocus"
                   KeyDown="OnSearchKeyDown" />
        </StackPanel>
        <Popup PlacementTarget="{Binding #MapSearchBox}"
               Placement="Bottom"
               VerticalOffset="2"
               IsOpen="{Binding HasSearchSuggestions}">
          <Border Width="320"
                  Background="#111926"
                  BorderBrush="#2B3C55"
                  BorderThickness="1"
                  CornerRadius="4">
            <ListBox ItemsSource="{Binding SearchSuggestions}"
                     SelectedItem="{Binding SelectedSearchSuggestion, Mode=TwoWay}"
                     SelectionChanged="OnSearchSuggestionSelected"
                     MaxHeight="240"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#D8E5F8" />
          </Border>
        </Popup>
        <Button Grid.Column="5" Content="Fit / Center" Click="OnFitCenterClicked" MinWidth="96" />
        <Button Grid.Column="6" Content="Tools" MinWidth="80">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="LY Coverage Planner" Click="OnOpenLyCoveragePlannerClicked" />
              <MenuItem Header="Jump Route Optimizer" Click="OnOpenJumpRouteOptimizerClicked" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <ToggleButton Grid.Column="7" Content="Display" IsChecked="{Binding IsDisplaySettingsOpen, Mode=TwoWay}" />
        <Button Grid.Column="8" Content="Settings" MinWidth="90">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Map Editor" Click="OnOpenMapEditorClicked" />
              <MenuItem Header="Preferences" Click="OnOpenPreferencesClicked" />
              <MenuItem Header="SOV Upgrades" Click="OnOpenSovUpgradesClicked" />
              <MenuItem Header="Ansiblex Network" Click="OnOpenAnsiblexNetworkClicked" />
              <MenuItem Header="Debug Window" Click="OnOpenDebugConsoleClicked" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <Grid Grid.Column="0">
        <rendering:MapControl x:Name="MainMapControl"
                              Graph="{Binding CurrentGraph}"
                              ViewMode="{Binding SelectedViewMode}"
                              PointerPressed="OnMainMapPointerPressed"
                              PointerMoved="OnMainMapPointerMoved"
                              PointerReleased="OnMainMapPointerReleased"
                              StretchToWindow="{Binding StretchMapToWindow}"
                              NodeColorMode="{Binding NodeColorMode}"
                              NodeBackgroundColorMode="{Binding NodeBackgroundColorMode}"
                              ShowIndicatorRegion="{Binding ShowIndicatorRegion}"
                              ShowIndicatorConstellation="{Binding ShowIndicatorConstellation}"
                              ShowIndicatorSecurityStatus="{Binding ShowIndicatorSecurityStatus}"
                              ShowIndicatorStarClass="{Binding ShowIndicatorStarClass}"
                              ShowIndicatorA0StarIcon="{Binding ShowIndicatorA0StarIcon}"
                              ShowIndicatorJoveObservatoryIcon="{Binding ShowIndicatorJoveObservatoryIcon}"
                              ShowIndicatorIceBeltsIcon="{Binding ShowIndicatorIceBeltsIcon}"
                              ShowIndicatorStormIcon="{Binding ShowIndicatorStormIcon}"
                              ShowIndicatorWormholeIcon="{Binding ShowIndicatorWormholeIcon}"
                              ShowIndicatorSovUpgradeIcon="{Binding ShowIndicatorSovUpgradeIcon}"
                              ShowIndicatorIncursionIcon="{Binding ShowIndicatorIncursionIcon}"
                              IndicatorSovUpgradeFilterKeys="{Binding SelectedIndicatorSovUpgradeKeys}"
                              InfoBoxShowRegion="{Binding InfoBoxShowRegion}"
                              InfoBoxShowConstellation="{Binding InfoBoxShowConstellation}"
                              InfoBoxShowSecurityStatus="{Binding InfoBoxShowSecurityStatus}"
                              InfoBoxShowStarClass="{Binding InfoBoxShowStarClass}"
                              InfoBoxShowA0StarIcon="{Binding InfoBoxShowA0StarIcon}"
                              InfoBoxShowJoveObservatoryIcon="{Binding InfoBoxShowJoveObservatoryIcon}"
                              InfoBoxShowIceBeltsIcon="{Binding InfoBoxShowIceBeltsIcon}"
                              InfoBoxShowStormIcon="{Binding InfoBoxShowStormIcon}"
                              InfoBoxShowWormholeIcon="{Binding InfoBoxShowWormholeIcon}"
                              InfoBoxShowSovUpgradeIcon="{Binding InfoBoxShowSovUpgradeIcon}"
                              InfoBoxShowIncursionIcon="{Binding InfoBoxShowIncursionIcon}"
                              OverlaySovUpgradeFilterKeys="{Binding SelectedOverlaySovUpgradeKeys}"
                              AlwaysShowHubWormholes="{Binding AlwaysShowHubWormholes}"
                              AlwaysShowIncursions="{Binding AlwaysShowIncursions}"
                              HubWormholeMarkerMode="{Binding HubWormholeMarkerMode}"
                              MissingConnectionNodeIds="{Binding MissingConnectionNodeIdsForView}"
                              ShowMissingConnectionMarkers="{Binding ShowMissingConnectionMarkers}"
                              JumpRangeOriginNodeIds="{Binding JumpRangeOriginNodeIdsForView}"
                              JumpRangeInRangeNodeIds="{Binding JumpRangeInRangeNodeIdsForView}"
                              JumpRangeOriginsDisplay="{Binding JumpRangeOriginsDisplayForView}"
                              JumpRangeMembershipByNodeId="{Binding JumpRangeMembershipByNodeIdForView}"
                              JumpRangeDistancesByNodeId="{Binding JumpRangeDistancesByNodeIdForView}"
                              LyCoverageCoveredNodeIds="{Binding LyCoverageCoveredNodeIdsForView}"
                              LyCoverageUncoveredNodeIds="{Binding LyCoverageUncoveredNodeIdsForView}"
                              JumpRouteNodeIds="{Binding JumpRouteNodeIdsForView}"
                              JumpRouteSkippedNodeIds="{Binding JumpRouteSkippedNodeIdsForView}"
                              EnableLinkAnimations="{Binding EnableLinkAnimations}"
                              AnsiblexLinks="{Binding AnsiblexLinksForView}"
                              ShowAnsiblexNetwork="{Binding ShowAnsiblexNetwork}"
                              ShowIndicatorJumpRangeLy="{Binding ShowIndicatorJumpRangeLy}"
                              InfoBoxShowJumpRangeLy="{Binding InfoBoxShowJumpRangeLy}"
                              SelectedNodeId="{Binding SelectedNodeId, Mode=TwoWay}" />
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="12"
                Padding="8"
                Background="#C0101724"
                BorderBrush="#5A7AA5D6"
                BorderThickness="1"
                CornerRadius="6"
                IsVisible="{Binding HasJumpRangeOverlay}">
          <StackPanel Spacing="4">
            <TextBlock Text="Jump Ranges" FontWeight="SemiBold" Foreground="#EAF3FF" />
            <ItemsControl ItemsSource="{Binding JumpRangeOriginsDisplayForView}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center">
                      <Border.Background>
                        <SolidColorBrush Color="{Binding ColorHex}" />
                      </Border.Background>
                    </Border>
                    <TextBlock Foreground="{Binding ColorHex}"
                               Text="{Binding SystemName}" />
                    <TextBlock Foreground="#9EB5D8"
                               Text="{Binding RangeLy, StringFormat='({0:0.0} LY)'}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="#6689A8CC" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Canvas Width="14" Height="14">
                  <Ellipse Width="12" Height="12"
                           Stroke="#F3BE5E"
                           StrokeThickness="2"
                           StrokeDashArray="3,2"
                           Fill="Transparent"
                           Canvas.Left="1"
                           Canvas.Top="1" />
                </Canvas>
                <TextBlock Foreground="#C7D8EF" Text="Dotted ring = jump-range source system" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Button HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="10"
                Width="22"
                Height="22"
                Padding="0"
                ZIndex="20"
                CornerRadius="11"
                Background="#2A3A52"
                BorderBrush="#5D83B5"
                BorderThickness="1"
                Foreground="#EAF2FF"
                FontWeight="Bold"
                FontSize="12"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="?"
                ToolTip.ShowDelay="80"
                ToolTip.Placement="Bottom">
          <ToolTip.Tip>
            <Border Background="#111926"
                    BorderBrush="#2B3C55"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8"
                    MaxWidth="320">
              <StackPanel Spacing="4">
                <TextBlock Text="Map Legend"
                           Foreground="#D8E5F8"
                           FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="18" Height="2" Background="#4D6FA2" VerticalAlignment="Center" />
                  <TextBlock Text="Link: same constellation"
                             Foreground="#C7D6EA"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="18" Height="2" Background="#3E8A7E" VerticalAlignment="Center" />
                  <TextBlock Text="Link: same region, different constellation"
                             Foreground="#C7D6EA"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="18" Height="2" Background="#8E5C8A" VerticalAlignment="Center" />
                  <TextBlock Text="Link: across regions"
                             Foreground="#C7D6EA"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAnsiblexLegendVisible}">
                  <Canvas Width="18" Height="8" VerticalAlignment="Center">
                    <Line StartPoint="0,4" EndPoint="18,4" Stroke="#E7C85A" StrokeThickness="2" StrokeDashArray="4.2,2.8" />
                  </Canvas>
                  <TextBlock Text="Ansiblex link"
                             Foreground="#C7D6EA"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRegionMode}">
                  <Canvas Width="16" Height="16">
                    <Ellipse Width="12" Height="12"
                             Stroke="#C567D6"
                             StrokeThickness="1.5"
                             StrokeDashArray="1.2,2.4"
                             Canvas.Left="2"
                             Canvas.Top="2" />
                  </Canvas>
                  <TextBlock Text="Region: hidden links outside current map"
                             Foreground="#C7D6EA"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding AlwaysShowHubWormholes}">
                  <Grid Width="16" Height="16">
                    <Grid IsVisible="{Binding IsWormholePreviewBadge}">
                      <Ellipse Width="10" Height="10" Fill="#93A8C0" Stroke="#1A2536" StrokeThickness="1.0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
                      <Border Background="#6BC1B5" BorderBrush="#0D131D" BorderThickness="1" CornerRadius="2"
                              Padding="2,0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,-5,0,0">
                        <TextBlock Text="T" FontSize="7" FontWeight="SemiBold" Foreground="#0D131D" />
                      </Border>
                    </Grid>
                    <Grid IsVisible="{Binding IsWormholePreviewRing}">
                      <Ellipse Width="10" Height="10" Fill="#93A8C0" Stroke="#1A2536" StrokeThickness="1.0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
                      <Ellipse Width="15" Height="15" Stroke="#6BC1B5" StrokeThickness="1.6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" />
                    </Grid>
                    <Grid IsVisible="{Binding IsWormholePreviewHalo}">
                      <Ellipse Width="15" Height="15" Fill="#4C6BC1B5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" />
                      <Ellipse Width="10" Height="10" Fill="#93A8C0" Stroke="#1A2536" StrokeThickness="1.0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
                    </Grid>
                  </Grid>
                  <TextBlock Text="Thera/Turnur marker shown on connected systems"
                             Foreground="#C7D6EA"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding AlwaysShowIncursions}">
                  <Border Width="16" Height="16" Background="#B24A2E78" BorderBrush="#3A6EA8" BorderThickness="1" CornerRadius="3">
                    <Image Source="avares://Hisa.App/Assets/Icons/incursion.png" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="Incursion badge shown on active systems"
                             Foreground="#C7D6EA"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>
          </ToolTip.Tip>
        </Button>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="12,12,12,56"
                Width="360"
                MaxHeight="420"
                Padding="10"
                Background="#D2101826"
                BorderBrush="#4E6B92C5"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsHubWormholesOverlayOpen}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding HubWormholeOverlayTitle}" Foreground="#EAF2FF" FontWeight="SemiBold" />
            <TextBlock Text="Data source: EvE-Scout (Thera/Turnur)" Foreground="#8FA5C4" FontSize="11" />
            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding HubWormholeCardsForView}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,8" ColumnDefinitions="4,*">
                      <Border Grid.Column="0" CornerRadius="4,0,0,4">
                        <Border.Background>
                          <SolidColorBrush Color="{Binding AccentHex}" />
                        </Border.Background>
                      </Border>
                      <Border Grid.Column="1"
                              Padding="9,8"
                              Background="#D0162234"
                              BorderThickness="1"
                              BorderBrush="#2F4566"
                              CornerRadius="0,7,7,0">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Foreground="#E9F4FF" FontWeight="Bold" FontSize="14" >
                              <Run Text="{Binding SystemName}" FontSize="14" />
                              <Run Text=" | " Foreground="#6F88A8"/>
                              <Run Text="{Binding ConstellationName}" FontWeight="SemiBold" FontSize="10"/>
                              <Run Text=" | " Foreground="#6F88A8" />
                              <Run Text="{Binding RegionName}" FontWeight="SemiBold" FontSize="10"/>
                            </TextBlock>
                            <Border Grid.Column="1" Padding="6,2" CornerRadius="4">
                              <Border.Background>#192838</Border.Background>
                              <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding AccentHex}" />
                              </Border.BorderBrush>
                              <Border.BorderThickness>1</Border.BorderThickness>
                              <TextBlock Text="{Binding HubSummary}" FontSize="10" FontWeight="Bold" Foreground="{Binding HubLabelColorHex}" />
                            </Border>
                            <Border Grid.Column="2" Padding="6,2" CornerRadius="4" Background="#3B2F11" BorderBrush="#F3BE5E" BorderThickness="1">
                              <TextBlock Text="{Binding ShipSizeSummary}" Foreground="#F3BE5E" FontSize="10" FontWeight="Bold" />
                            </Border>
                            <!-- <Border Grid.Column="3" Padding="6,2" CornerRadius="4" Background="#22354F" BorderBrush="#355277" BorderThickness="1">
                              <TextBlock Text="{Binding ConnectionCount, StringFormat='x{0}'}" Foreground="#CAE0FA" FontSize="10" FontWeight="Bold" />
                            </Border> -->
                          </Grid>

                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <Border Grid.Column="0" Background="#152337" BorderBrush="#2B3F5D" BorderThickness="1" CornerRadius="5" Padding="6,4">
                              <TextBlock Text="{Binding SignatureSummary}" Foreground="#D2E6FF" FontSize="11" TextWrapping="Wrap" />
                            </Border>
                            <Border Grid.Column="1" Background="#1B2C43" BorderBrush="#2D486C" BorderThickness="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                              <TextBlock Text="{Binding ExpirySummary}" FontSize="10" Foreground="{Binding ExpiryColorHex}" />
                            </Border>
                          </Grid>

                          <Border Background="#1A2639" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,4,4">
                            <TextBlock Text="{Binding ReportedUpdatedSummary}" Foreground="#9DB8D8" FontSize="10" />
                          </Border>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="No wormholes available in this view." Foreground="#7F93AE" IsVisible="{Binding HasNoHubWormholeOverlayData}" />
          </StackPanel>
        </Border>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="12,12,12,56"
                Width="360"
                MaxHeight="420"
                Padding="10"
                Background="#D2101826"
                BorderBrush="#4E6B92C5"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsIncursionsOverlayOpen}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding IncursionOverlayTitle}" Foreground="#EAF2FF" FontWeight="SemiBold" />
            <TextBlock Text="Data source: ESI Incursions" Foreground="#8FA5C4" FontSize="11" />
            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding IncursionCardsForView}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,8" ColumnDefinitions="4,*">
                      <Border Grid.Column="0" CornerRadius="4,0,0,4">
                        <Border.Background>
                          <SolidColorBrush Color="{Binding AccentHex}" />
                        </Border.Background>
                      </Border>
                      <Border Grid.Column="1"
                              Padding="9,8"
                              Background="#D01A2232"
                              BorderThickness="1"
                              BorderBrush="#3B4262"
                              CornerRadius="0,7,7,0">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Foreground="#F1E8FF" FontWeight="Bold" FontSize="14" >
                              <Run Text="{Binding StagingSystemName}" FontWeight="Bold" FontSize="14"/>
                              <Run Text=" | " Foreground="#7F779C" />
                              <Run Text="{Binding ConstellationName}" FontWeight="SemiBold" FontSize="10"/>
                              <Run Text=" | " Foreground="#7F779C" />
                              <Run Text="{Binding RegionName}" FontWeight="SemiBold" FontSize="10" />
                            </TextBlock>
                            <Border Grid.Column="1" Padding="6,2" CornerRadius="4" Background="#241C35" BorderThickness="1" BorderBrush="{Binding StateColorHex}">
                              <TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateColorHex}" FontSize="10" FontWeight="Bold" />
                            </Border>
                            
                          </Grid>

                          <WrapPanel>
                            <Border Background="#2A2340" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4" BorderBrush="{Binding TypeColorHex}">
                              <TextBlock Text="{Binding TypeLabel}" Foreground="{Binding TypeColorHex}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#2A2340" BorderBrush="#4D3C73" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                              <TextBlock Text="{Binding AffectedSystemsLabel}" Foreground="#EBDFFF" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            
                            <Border Grid.Column="2" Padding="6,2" CornerRadius="4" Background="#2E2642" BorderBrush="#594D7F" BorderThickness="1">
                              <TextBlock Text="{Binding InfluenceLabel}" Foreground="#EBDFFF" FontSize="10" FontWeight="Bold" />
                            </Border>
                          </WrapPanel>

                          <Border Background="#231E32" BorderThickness="1" CornerRadius="5" Padding="6,4" BorderBrush="{Binding BossColorHex}">
                            <TextBlock Text="{Binding BossLabel}" Foreground="{Binding BossColorHex}" FontSize="10" FontWeight="SemiBold" />
                          </Border>

                        </StackPanel>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="No incursions available in this view." Foreground="#7F93AE" IsVisible="{Binding HasNoIncursionOverlayData}" />
          </StackPanel>
        </Border>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="12,12,12,56"
                Width="360"
                MaxHeight="420"
                Padding="10"
                Background="#D2101826"
                BorderBrush="#4E6B92C5"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsStormsOverlayOpen}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding StormOverlayTitle}" Foreground="#EAF2FF" FontWeight="SemiBold" />
            <TextBlock Text="Data source: EvE-Scout Storm Observations" Foreground="#8FA5C4" FontSize="11" />
            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding StormCardsForView}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,8" ColumnDefinitions="4,*">
                      <Border Grid.Column="0" CornerRadius="4,0,0,4">
                        <Border.Background>
                          <SolidColorBrush Color="{Binding AccentHex}" />
                        </Border.Background>
                      </Border>
                      <Border Grid.Column="1"
                              Padding="9,8"
                              Background="#D01A2232"
                              BorderThickness="1"
                              BorderBrush="#3B4262"
                              CornerRadius="0,7,7,0">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Foreground="#EAF3FF" FontWeight="Bold" FontSize="14" >
                              <Run Text="{Binding CenterSystemName}" FontWeight="Bold" FontSize="14"/>
                              <Run Text=" | " Foreground="#7F8EA1" />
                              <Run Text="{Binding ConstellationName}" FontWeight="SemiBold" FontSize="10"/>
                              <Run Text=" | " Foreground="#7F8EA1" />
                              <Run Text="{Binding RegionName}" FontWeight="SemiBold" FontSize="10" />
                            </TextBlock>
                            <Border Grid.Column="1" Padding="6,2" CornerRadius="4" Background="#1C2838" BorderThickness="1" BorderBrush="{Binding StormTypeColorHex}">
                              <TextBlock Text="{Binding StormTypeLabel}" Foreground="{Binding StormTypeColorHex}" FontSize="10" FontWeight="Bold" />
                            </Border>
                          </Grid>

                          <WrapPanel>
                            <Border Background="#233448" BorderBrush="#3A5776" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                              <TextBlock Text="{Binding CoverageSummary}" Foreground="#CDE1F8" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#233448" BorderBrush="#3A5776" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                              <TextBlock Text="{Binding StrengthSummary}" Foreground="#CDE1F8" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                          </WrapPanel>

                          <Border Background="#1A2639" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="4" Padding="6,3">
                            <TextBlock Text="{Binding ReportedSummary}" Foreground="#9DB8D8" FontSize="10" />
                          </Border>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="No storms available." Foreground="#7F93AE" IsVisible="{Binding HasNoStormOverlayData}" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Column="1"
              Width="300"
              Background="#121A26"
              BorderBrush="#263244"
              BorderThickness="1,0,0,0"
              Padding="10"
              IsVisible="{Binding IsDisplaySettingsOpen}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <TextBlock Text="Display Settings" FontSize="14" FontWeight="SemiBold" Foreground="#D8E5F8" />

            <TextBlock Text="Node Color" Foreground="#8A96A8" />
            <ComboBox ItemsSource="{Binding NodeColorModes}" SelectedItem="{Binding NodeColorMode}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource MapNodeColorModeDisplayConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Node Background Color" Foreground="#8A96A8" />
            <ComboBox ItemsSource="{Binding NodeColorModes}" SelectedItem="{Binding NodeBackgroundColorMode}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource MapNodeColorModeDisplayConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Indicators" Foreground="#8A96A8" />
            <CheckBox IsChecked="{Binding ShowIndicatorSecurityStatus}" Content="Security Status" />
            <CheckBox IsChecked="{Binding ShowIndicatorRegion}" Content="Region" />
            <CheckBox IsChecked="{Binding ShowIndicatorConstellation}" Content="Constellation" />
            <CheckBox IsChecked="{Binding ShowIndicatorStarClass}" Content="Star Class" />
            <CheckBox IsChecked="{Binding ShowIndicatorA0StarIcon}" Content="A0 Stars" />
            <CheckBox IsChecked="{Binding ShowIndicatorJoveObservatoryIcon}" Content="Jove Observatory" />
            <CheckBox IsChecked="{Binding ShowIndicatorIceBeltsIcon}" Content="Ice Belts" />
            <CheckBox IsChecked="{Binding ShowIndicatorStormIcon}" Content="Metaliminal Storms" />
            <CheckBox IsChecked="{Binding ShowIndicatorWormholeIcon}" Content="Thera/Turnur Wormholes" />
            <CheckBox IsChecked="{Binding ShowIndicatorIncursionIcon}" Content="Incursions" />
            <CheckBox IsChecked="{Binding ShowIndicatorJumpRangeLy}" Content="Jump Range LY" />
            <CheckBox IsChecked="{Binding ShowAnsiblexNetwork}" Content="Ansiblex Network" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <CheckBox IsChecked="{Binding ShowIndicatorSovUpgradeIcon}" Content="SOV Upgrades" />
              <Button Width="24" Height="24" Padding="0">
                <Image Source="avares://Hisa.App/Assets/Icons/settings.png" Width="14" Height="14" />
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <Border Width="360" Padding="8" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4">
                      <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Content="Select All" Click="OnSelectAllIndicatorSovFilterClicked" />
                          <Button Content="Unselect All" Click="OnUnselectAllIndicatorSovFilterClicked" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding IndicatorSovUpgradeOptions}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SovUpgradeDisplayOption">
                              <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="6,4" Margin="2" BorderThickness="1" BorderBrush="#2B3C55">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <Image Source="{Binding Icon}" Width="16" Height="16" />
                                  <TextBlock Text="{Binding DisplayName}" />
                                </StackPanel>
                              </ToggleButton>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>

            <Separator />

            <TextBlock Text="Overlay Fields" Foreground="#8A96A8" />
            <CheckBox IsChecked="{Binding InfoBoxShowSecurityStatus}" Content="Security Status" />
            <CheckBox IsChecked="{Binding InfoBoxShowRegion}" Content="Region" />
            <CheckBox IsChecked="{Binding InfoBoxShowConstellation}" Content="Constellation" />
            <CheckBox IsChecked="{Binding InfoBoxShowStarClass}" Content="Star Class" />
            <CheckBox IsChecked="{Binding InfoBoxShowA0StarIcon}" Content="A0 Stars" />
            <CheckBox IsChecked="{Binding InfoBoxShowJoveObservatoryIcon}" Content="Jove Observatory" />
            <CheckBox IsChecked="{Binding InfoBoxShowIceBeltsIcon}" Content="Ice Belts" />
            <CheckBox IsChecked="{Binding InfoBoxShowStormIcon}" Content="Metaliminal Storms" />
            <CheckBox IsChecked="{Binding InfoBoxShowWormholeIcon}" Content="Thera/Turnur Wormholes" />
            <CheckBox IsChecked="{Binding InfoBoxShowIncursionIcon}" Content="Incursions" />
            <CheckBox IsChecked="{Binding InfoBoxShowJumpRangeLy}" Content="Jump Range LY" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <CheckBox IsChecked="{Binding InfoBoxShowSovUpgradeIcon}" Content="SOV Upgrades" />
              <Button Width="24" Height="24" Padding="0">
                <Image Source="avares://Hisa.App/Assets/Icons/settings.png" Width="14" Height="14" />
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <Border Width="360" Padding="8" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4">
                      <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Content="Select All" Click="OnSelectAllOverlaySovFilterClicked" />
                          <Button Content="Unselect All" Click="OnUnselectAllOverlaySovFilterClicked" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding OverlaySovUpgradeOptions}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SovUpgradeDisplayOption">
                              <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="6,4" Margin="2" BorderThickness="1" BorderBrush="#2B3C55">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <Image Source="{Binding Icon}" Width="16" Height="16" />
                                  <TextBlock Text="{Binding DisplayName}" />
                                </StackPanel>
                              </ToggleButton>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2" Padding="8" Background="#121A26" BorderThickness="0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#8A96A8" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <ToggleButton Content="Thera/Turnur Wormholes"
                        IsChecked="{Binding IsHubWormholesOverlayOpen, Mode=TwoWay}"
                        Background="#162131"
                        BorderBrush="#2E4B73"
                        Foreground="#D5E7FF"
                        Padding="10,4"
                        MinWidth="188" />
          <ToggleButton Content="Incursions"
                        IsChecked="{Binding IsIncursionsOverlayOpen, Mode=TwoWay}"
                        Background="#24172F"
                        BorderBrush="#5B3D7A"
                        Foreground="#E6D9FF"
                        Padding="10,4"
                        MinWidth="108" />
          <ToggleButton Content="Storms"
                        IsChecked="{Binding IsStormsOverlayOpen, Mode=TwoWay}"
                        Background="#18283B"
                        BorderBrush="#35587B"
                        Foreground="#D9EBFF"
                        Padding="10,4"
                        MinWidth="92" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
