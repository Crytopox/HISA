<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:Hisa.App"
        mc:Ignorable="d"
        x:Class="Hisa.App.AnsiblexNetworkWindow"
        x:DataType="app:MainWindowViewModel"
        Width="1180"
        Height="860"
        Title="Ansiblex Network"
        Background="#0D131D">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="12">
    <TextBlock Text="Ansiblex Network" Foreground="#D8E5F8" FontSize="16" FontWeight="SemiBold" />
    <Border Grid.Row="1" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="Capital and ship class" Foreground="#8A96A8" />
        <Grid ColumnDefinitions="220,Auto,16,220,Auto" ColumnSpacing="0">
          <TextBox Grid.Column="0" x:Name="CapitalSystemBox" Watermark="Capital system" />
          <Button Grid.Column="1" Content="Set capital" Margin="8,0,0,0" Click="OnSetCapitalClicked" />
          <ComboBox Grid.Column="3" x:Name="ShipClassCombo" Width="220" SelectionChanged="OnShipClassChanged" />
        </Grid>
        <TextBlock x:Name="CapitalStatusText" Foreground="#D8E5F8" Text="No capital set" />
        <TextBlock x:Name="SummaryText" Foreground="#8A96A8" TextWrapping="Wrap" />
        <CheckBox IsChecked="{Binding ShowAnsiblexCapitalRing}" Content="Show capital circle on map" Foreground="#D8E5F8" />
        <CheckBox IsChecked="{Binding ShowAnsiblexCapitalHoverLine}" Content="Show capital, distance, and ship on hover" Foreground="#D8E5F8" />
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Import mode" VerticalAlignment="Center" Foreground="#8A96A8" />
          <ComboBox x:Name="ImportModeCombo" Width="190" SelectedIndex="0">
            <ComboBoxItem Content="Delete Previous (Default)" />
            <ComboBoxItem Content="Update on Change" />
            <ComboBoxItem Content="Append" />
          </ComboBox>
          <Button Content="Import / Apply" Click="OnImportClicked" />
        </StackPanel>
        <TextBlock Text="Paste Input" Foreground="#8A96A8" />
        <TextBox x:Name="ImportTextBox"
                 Watermark="Supported: full Goonwiki page/table paste, Dotlan universe link (system::system,system::system), SYSTEM &lt;-&gt; SYSTEM, SYSTEM -&gt; SYSTEM, SYSTEM,SYSTEM"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalAlignment="Stretch"
                 Height="160" />
      </StackPanel>
    </Border>
    <Border Grid.Row="3" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="Manual Add / Remove" Foreground="#8A96A8" />
        <Grid ColumnDefinitions="180,180,Auto,Auto" ColumnSpacing="6">
          <TextBox Grid.Column="0" x:Name="ManualFromSystemBox" Watermark="From system" />
          <TextBox Grid.Column="1" x:Name="ManualToSystemBox" Watermark="To system" />
          <Button Grid.Column="2" Content="Add / Update" Click="OnAddManualClicked" />
          <Button Grid.Column="3" Content="Remove Link" Click="OnRemoveLinkClicked" />
        </Grid>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="4" Text="Saved Links" Foreground="#8A96A8" Margin="0,10,0,6" />
    <Border Grid.Row="5" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="6">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="170,150,40,170,150,90,90" Margin="4,2,4,6">
          <TextBlock Grid.Column="0" Text="From" Foreground="#8A96A8" />
          <TextBlock Grid.Column="1" Text="From zone" Foreground="#8A96A8" />
          <TextBlock Grid.Column="3" Text="To" Foreground="#8A96A8" />
          <TextBlock Grid.Column="4" Text="To zone" Foreground="#8A96A8" />
          <TextBlock Grid.Column="5" Text="To the right" Foreground="#8A96A8" />
          <TextBlock Grid.Column="6" Text="To the left" Foreground="#8A96A8" />
        </Grid>
        <ListBox x:Name="SavedLinksList" Height="220" BorderThickness="0" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:AnsiblexLinkListRow">
              <Grid ColumnDefinitions="170,150,40,170,150,90,90" Margin="2">
                <TextBlock Grid.Column="0" Text="{Binding FromSystemName}" Foreground="#D8E5F8" />
                <TextBlock Grid.Column="1" Text="{Binding FromZoneText}" Foreground="#D8E5F8" />
                <TextBlock Grid.Column="2" Text="&lt;--&gt;" Foreground="#71D3D8" />
                <TextBlock Grid.Column="3" Text="{Binding ToSystemName}" Foreground="#D8E5F8" />
                <TextBlock Grid.Column="4" Text="{Binding ToZoneText}" Foreground="#D8E5F8" />
                <TextBlock Grid.Column="5" Text="{Binding TowardToText}" Foreground="#F5C06A" />
                <TextBlock Grid.Column="6" Text="{Binding TowardFromText}" Foreground="#F5C06A" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <TextBlock x:Name="StatusText" Grid.Row="6" Foreground="#8A96A8" Margin="0,8,0,0" TextWrapping="Wrap" />
  </Grid>
</Window>
