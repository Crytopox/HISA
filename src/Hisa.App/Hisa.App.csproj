<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <XmppAssetRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</XmppAssetRuntime>
    <XmppAssetRuntime Condition="'$(XmppAssetRuntime)' == ''">$(NETCoreSdkRuntimeIdentifier)</XmppAssetRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../../build/xmpp-native/$(XmppAssetRuntime)/*"
             Condition="'$(XmppAssetRuntime)' != ''">
      <Link>XmppNative/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <ProjectReference Include="..\Hisa.Core\Hisa.Core.csproj" />
    <ProjectReference Include="..\Hisa.Logs\Hisa.Logs.csproj" />
    <ProjectReference Include="..\Hisa.Esi\Hisa.Esi.csproj" />
    <ProjectReference Include="..\Hisa.Data\Hisa.Data.csproj" />
    <ProjectReference Include="..\Hisa.Rendering\Hisa.Rendering.csproj" />
    <ProjectReference Include="..\Hisa.Services\Hisa.Services.csproj" />
  </ItemGroup>
  <Target Name="VerifyXmppReleaseAssets" BeforeTargets="PrepareForPublish"
          Condition="'$(RequireXmppNative)' == 'true'">
    <Error Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) And !Exists('$(MSBuildThisFileDirectory)../../build/xmpp-native/$(RuntimeIdentifier)/hisa-strophe.dll')"
           Text="The Windows XMPP library is missing. Build the native asset first." />
    <Error Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')) And !Exists('$(MSBuildThisFileDirectory)../../build/xmpp-native/$(RuntimeIdentifier)/libhisa-strophe.so')"
           Text="The Linux XMPP library is missing. Build the native asset first." />
    <Error Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-')) And !Exists('$(MSBuildThisFileDirectory)../../build/xmpp-native/$(RuntimeIdentifier)/libhisa-strophe.dylib')"
           Text="The macOS XMPP library is missing. Build the native asset first." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.7" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="System.Windows.Extensions" Version="10.0.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hisa.App.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HISA</AssemblyName>
    <Product>HISA</Product>
    <Title>HISA</Title>
    <Version>1.13.0</Version>
    <ApplicationIcon>Assets\HISA-Logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaDisableTelemetry>true</AvaloniaDisableTelemetry>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\Sounds\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Content Include="Data\eve-hk-sde.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Data\solarSystemsStaticData.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
