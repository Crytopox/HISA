<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:Hisa.App"
        mc:Ignorable="d"
        x:Class="Hisa.App.LyCoveragePlannerWindow"
        Width="860"
        Height="620"
        Title="LY Coverage Planner"
        Background="#0D131D">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="8">
    <StackPanel Spacing="2">
      <TextBlock Text="LY Coverage Planner" Foreground="#D8E5F8" FontSize="14" FontWeight="SemiBold" />
      <TextBlock Text="Find center candidates that cover as many target systems as possible in selected jump range."
                 Foreground="#8FA5C4" FontSize="11" />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,6,0,0" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="6">
      <Grid ColumnDefinitions="Auto,70,Auto,54,Auto,Auto,Auto,*" ColumnSpacing="5">
        <TextBlock Grid.Column="0" Text="Jump Range (LY)" VerticalAlignment="Center" Foreground="#8FA5C4" />
        <TextBox Grid.Column="1" x:Name="RangeLyTextBox" Text="7.0" />
        <TextBlock Grid.Column="2" Text="Top Results" VerticalAlignment="Center" Foreground="#8FA5C4" />
        <TextBox Grid.Column="3" x:Name="TopResultsTextBox" Width="52" Text="50" />
        <CheckBox Grid.Column="4" x:Name="InputOnlyCentersCheckBox" Content="Input systems as centers only" VerticalAlignment="Center" />
        <Button Grid.Column="5" Content="Analyze" Click="OnAnalyzeClicked" />
        <Button Grid.Column="6" Content="Apply Selected To Map" Click="OnApplySelectedClicked" HorizontalAlignment="Left" />
        <Button Grid.Column="7" Content="Clear Map" Click="OnClearMapClicked" HorizontalAlignment="Left" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="0,6,0,0" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="6">
      <StackPanel Spacing="4">
        <TextBlock Text="Input target systems (space/comma/newline separated)" Foreground="#8FA5C4" FontSize="11" />
        <TextBox x:Name="InputSystemsTextBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Margin="0,6,0,0" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="5">
      <StackPanel Spacing="4">
        <TextBlock Text="Map Legend (LY Coverage Planner)" Foreground="#D8E5F8" FontWeight="SemiBold" FontSize="12" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Canvas Width="16" Height="16">
              <Ellipse Width="12" Height="12" Stroke="#59D38C" StrokeThickness="2" StrokeDashArray="2,2" Fill="Transparent" Canvas.Left="2" Canvas.Top="2" />
            </Canvas>
            <TextBlock Text="Covered target" Foreground="#BFD4EC" VerticalAlignment="Center" FontSize="11" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Canvas Width="16" Height="16">
              <Ellipse Width="12" Height="12" Stroke="#FF6A6A" StrokeThickness="2" StrokeDashArray="1.6,1.6" Fill="Transparent" Canvas.Left="2" Canvas.Top="2" />
            </Canvas>
            <TextBlock Text="Uncovered target" Foreground="#BFD4EC" VerticalAlignment="Center" FontSize="11" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Canvas Width="16" Height="16">
              <Ellipse Width="12" Height="12" Stroke="#F3BE5E" StrokeThickness="2" StrokeDashArray="3.2,2.0" Fill="Transparent" Canvas.Left="2" Canvas.Top="2" />
            </Canvas>
            <TextBlock Text="Selected center" Foreground="#BFD4EC" VerticalAlignment="Center" FontSize="11" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="4" Margin="0,6,0,0" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="5">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock x:Name="SummaryTextBlock" Foreground="#8FA5C4" Margin="0,0,0,4" FontSize="11" Text="Run analysis to see candidate center systems." />
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="#18263A" BorderBrush="#2C425F" BorderThickness="1" CornerRadius="4" Padding="5,4">
            <Grid ColumnDefinitions="150,84,64,70,70,*" ColumnSpacing="5">
              <TextBlock Grid.Column="0" Text="Center" Foreground="#CFE4FF" FontWeight="SemiBold" FontSize="11.5" />
              <TextBlock Grid.Column="1" Text="Covered" Foreground="#CFE4FF" FontWeight="SemiBold" FontSize="11.5" />
              <TextBlock Grid.Column="2" Text="Coverage %" Foreground="#CFE4FF" FontWeight="SemiBold" FontSize="11.5" />
              <TextBlock Grid.Column="3" Text="Avg LY" Foreground="#CFE4FF" FontWeight="SemiBold" FontSize="11.5" />
              <TextBlock Grid.Column="4" Text="Max LY" Foreground="#CFE4FF" FontWeight="SemiBold" FontSize="11.5" />
              <TextBlock Grid.Column="5" Text="Uncovered" Foreground="#CFE4FF" FontWeight="SemiBold" FontSize="11.5" />
            </Grid>
          </Border>
          <ListBox Grid.Row="1" x:Name="CandidatesListBox" BorderThickness="0" Background="Transparent" Margin="0,4,0,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:LyCoverageCandidateRow">
              <Grid ColumnDefinitions="150,84,64,70,70,*" ColumnSpacing="5" Margin="1">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding CenterSystemName}" Foreground="#D8E5F8" FontWeight="SemiBold" FontSize="11.5" />
                  <TextBlock Text="{Binding RegionName}" Foreground="#8FA5C4" FontSize="10" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding CoveredText}" Foreground="#CFE4FF" VerticalAlignment="Center" FontSize="11.5" />
                <TextBlock Grid.Column="2" Text="{Binding CoveragePercentText}" Foreground="#CFE4FF" VerticalAlignment="Center" FontSize="11.5" />
                <TextBlock Grid.Column="3" Text="{Binding AverageDistanceLyText}" Foreground="#CFE4FF" VerticalAlignment="Center" FontSize="11.5" />
                <TextBlock Grid.Column="4" Text="{Binding MaxDistanceLyText}" Foreground="#CFE4FF" VerticalAlignment="Center" FontSize="11.5" />
                <TextBlock Grid.Column="5" Text="{Binding UncoveredPreview}" Foreground="#AFC6E2" TextWrapping="Wrap" FontSize="11.5" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        
      </Grid>
    </Border>

    <TextBlock Grid.Row="5" x:Name="StatusTextBlock" Foreground="#8FA5C4" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
  </Grid>
</Window>
