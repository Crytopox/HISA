<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Hisa.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="360"
        x:Class="Hisa.App.AlertPopupWindow"
        Title="Alerts"
        SystemDecorations="None"
        CanResize="False"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent">
  <Border Margin="8"
          Padding="8"
          CornerRadius="8"
          Background="#0F1521CC"
          BorderBrush="#355178"
          BorderThickness="1">
    <ItemsControl x:Name="AlertsItemsControl">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AlertPopupCard">
          <Border Margin="0,0,0,8" Padding="8" Background="#182434E6" BorderBrush="#3D5A82" BorderThickness="1" CornerRadius="6">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Title}" Foreground="#EAF2FF" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Details}" Foreground="#BFD2EC" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding TimestampLabel}" Foreground="#8DA8C8" FontSize="10"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</Window>
