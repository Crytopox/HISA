<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Hisa.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="320"
        x:Class="Hisa.App.AlertPopupWindow"
        Title="Alerts"
        SystemDecorations="None"
        CanResize="False"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
  <Border x:Name="RootBorder"
          Margin="0"
          Padding="0"
          CornerRadius="0"
          BorderThickness="0"
          PointerPressed="OnRootPointerPressed"
          PointerReleased="OnRootPointerReleased">
    <ItemsControl x:Name="AlertsItemsControl">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AlertPopupCard">
          <StackPanel Spacing="0" Margin="0,0,0,5">
            <Grid ColumnDefinitions="3,*" IsVisible="{Binding HasIntelCard}">
              <Border Grid.Column="0" CornerRadius="4,0,0,4" Background="{Binding IntelCard.AccentHex}" />
              <Border Grid.Column="1"
                      Padding="6,5"
                      Background="#D01A2232"
                      BorderThickness="1"
                      BorderBrush="#2F4566"
                      CornerRadius="0,7,7,0">
                <StackPanel Spacing="3">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                    <Button Grid.Column="0"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ClickMode="Press"
                            Click="OnIntelCardSystemClicked">
                      <TextBlock Foreground="#F1E8FF" FontWeight="Bold" FontSize="12">
                        <Run Text="{Binding IntelCard.SystemName}" />
                        <Run Text=" | " Foreground="#7F779C" />
                        <Run Text="{Binding IntelCard.RegionName}" FontWeight="SemiBold" FontSize="9" />
                      </TextBlock>
                    </Button>
                    <Border Grid.Column="1" Padding="5,1" CornerRadius="4" BorderBrush="#5D83B5" BorderThickness="1" IsVisible="{Binding HasJumpCount}" ToolTip.Tip="{Binding JumpCountTooltip}">
                      <Border.Background>#192838</Border.Background>
                      <TextBlock Text="{Binding JumpCountLabel}" Foreground="#BFD8FF" FontSize="9" FontWeight="Bold" />
                    </Border>
                    <Border Grid.Column="2" Background="{Binding IntelCard.HostileBadgeBackgroundHex}" BorderThickness="1" CornerRadius="4" Padding="5,1" BorderBrush="{Binding IntelCard.HostileBadgeBorderHex}">
                      <TextBlock Text="{Binding IntelCard.HostileCount, StringFormat='Hostiles: {0}'}" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold" />
                    </Border>
                    <Border Grid.Column="3" Padding="5,1" CornerRadius="4" BorderBrush="#5D83B5" BorderThickness="1">
                      <Border.Background>#192838</Border.Background>
                      <TextBlock Text="{Binding IntelCard.AgeSummary}" Foreground="#BFD8FF" FontSize="9" FontWeight="Bold" />
                    </Border>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding IntelCard.PopupVisibleShips}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="92" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border HorizontalAlignment="Left" Margin="0,0,4,4" Background="#172234" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="4" Padding="3,1" Width="88">
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <Image Width="16" Height="16" Stretch="UniformToFill" Source="{Binding ShipBitmap}" IsVisible="{Binding HasShipBitmap}" />
                            <Border Width="16" Height="16" Background="#101927" BorderBrush="#2A3C58" BorderThickness="1" IsVisible="{Binding HasNoShipBitmap}">
                              <TextBlock Text="?" Foreground="#BFD8FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Foreground="#EAF2FF" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="62">
                              <Run Text="{Binding Count}" />
                              <Run Text="x " />
                              <Run Text="{Binding ShipName}" />
                            </TextBlock>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border HorizontalAlignment="Left"
                          Margin="0,0,4,4"
                          Background="#223248"
                          BorderBrush="#3A5776"
                          BorderThickness="1"
                          CornerRadius="4"
                          Padding="5,1"
                          IsVisible="{Binding IntelCard.PopupHasHiddenShipSummary}">
                    <TextBlock Text="{Binding IntelCard.PopupHiddenShipSummaryLabel}" Foreground="#CDE1F8" FontSize="8" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="Friendly"
                             Foreground="#8FDCB0"
                             FontSize="8"
                             FontWeight="Bold"
                             IsVisible="{Binding IntelCard.HasFriendlyShips}" />
                  <ItemsControl ItemsSource="{Binding IntelCard.PopupVisibleFriendlyShips}" IsVisible="{Binding IntelCard.HasFriendlyShips}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="92" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border HorizontalAlignment="Left" Margin="0,0,4,4" Background="#172A22" BorderBrush="#2A5840" BorderThickness="1" CornerRadius="4" Padding="3,1" Width="88">
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <Image Width="16" Height="16" Stretch="UniformToFill" Source="{Binding ShipBitmap}" IsVisible="{Binding HasShipBitmap}" />
                            <Border Width="16" Height="16" Background="#101927" BorderBrush="#2A5840" BorderThickness="1" IsVisible="{Binding HasNoShipBitmap}">
                              <TextBlock Text="?" Foreground="#C8F0D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Foreground="#C8F0D4" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="62">
                              <Run Text="{Binding Count}" />
                              <Run Text="x " />
                              <Run Text="{Binding ShipName}" />
                            </TextBlock>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border HorizontalAlignment="Left"
                          Margin="0,0,4,4"
                          Background="#1B3A2A"
                          BorderBrush="#2A5840"
                          BorderThickness="1"
                          CornerRadius="4"
                          Padding="5,1"
                          IsVisible="{Binding IntelCard.PopupHasHiddenFriendlyShipSummary}">
                    <TextBlock Text="{Binding IntelCard.PopupHiddenFriendlyShipSummaryLabel}" Foreground="#C8F0D4" FontSize="8" FontWeight="SemiBold" />
                  </Border>
                  <ItemsControl ItemsSource="{Binding IntelCard.PopupVisibleHostiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#1A2639" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="4" Padding="3,2" Margin="0,0,0,2" ToolTip.Tip="{Binding TooltipText}">
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <Button Width="24" Height="24" Padding="0" Background="#202F43" BorderThickness="0" Click="OnIntelHostilePortraitClicked">
                              <Grid>
                                <Image Width="24" Height="24" Stretch="UniformToFill" Source="{Binding PortraitBitmap}" IsVisible="{Binding HasPortraitBitmap}" />
                                <TextBlock Text="{Binding PortraitFallbackText}" Foreground="#DDEAFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoPortraitBitmap}" />
                              </Grid>
                            </Button>
                            <Button Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Click="OnIntelHostileCorporationClicked" IsVisible="{Binding HasCorporation}">
                              <Image Width="24" Height="24" Stretch="UniformToFill" Source="{Binding CorporationBitmap}" />
                            </Button>
                            <Button Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Click="OnIntelHostileAllianceClicked" IsVisible="{Binding HasAlliance}">
                              <Image Width="24" Height="24" Stretch="UniformToFill" Source="{Binding AllianceBitmap}" />
                            </Button>
                            <StackPanel Spacing="0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding MembershipTickerSummary}" Foreground="#9DB8D8" FontSize="8" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border HorizontalAlignment="Left" Background="#241C35" BorderBrush="#5D83B5" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,0,2" IsVisible="{Binding IntelCard.PopupHasHiddenHostiles}">
                    <TextBlock Text="{Binding IntelCard.PopupHiddenHostilesSummary}" Foreground="#BFD8FF" FontSize="9" FontWeight="Bold" />
                  </Border>
                  <TextBlock Text="{Binding IntelCard.MessageText}" Foreground="#C9D7EA" FontSize="9" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="3,*" IsVisible="{Binding HasZkillmailCard}">
              <Border Grid.Column="0" CornerRadius="4,0,0,4" Background="#FFB347" />
              <Border Grid.Column="1" Padding="6,5" Background="#D01A2232" BorderThickness="1" BorderBrush="#3B4262" CornerRadius="0,7,7,0">
                <StackPanel Spacing="3">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                    <Button Grid.Column="0"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ClickMode="Press"
                            Click="OnZkillCardSystemClicked">
                      <TextBlock Foreground="#F1E8FF" FontWeight="Bold" FontSize="12">
                        <Run Text="{Binding ZkillmailCard.SystemName}" />
                        <Run Text=" | " Foreground="#7F779C" />
                        <Run Text="{Binding ZkillmailCard.RegionName}" FontWeight="SemiBold" FontSize="9" />
                      </TextBlock>
                    </Button>
                    <Border Grid.Column="1" Padding="5,1" CornerRadius="4" BorderBrush="#5D83B5" BorderThickness="1" IsVisible="{Binding HasJumpCount}" ToolTip.Tip="{Binding JumpCountTooltip}">
                      <Border.Background>#192838</Border.Background>
                      <TextBlock Text="{Binding JumpCountLabel}" Foreground="#BFD8FF" FontSize="9" FontWeight="Bold" />
                    </Border>
                    <Border Grid.Column="2" Background="#3A2A2A" BorderThickness="1" CornerRadius="4" Padding="5,1" BorderBrush="#8A4C4C">
                      <TextBlock Text="{Binding ZkillmailCard.HostileCount, StringFormat='Hostiles: {0}'}" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold" />
                    </Border>
                    <Border Grid.Column="3" Padding="5,1" CornerRadius="4" Background="#241C35" BorderThickness="1" BorderBrush="#5D83B5">
                      <TextBlock Text="{Binding ZkillmailCard.AgeSummary}" Foreground="#BFD8FF" FontSize="9" FontWeight="Bold" />
                    </Border>
                  </Grid>
                  <Border Background="#1A2639" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="4" Padding="3,2">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                      <Button Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Click="OnZkillmailLinkClicked" ToolTip.Tip="Open killmail on zKillboard">
                        <Image Source="avares://HISA/Assets/Icons/killmail.png" Width="24" Height="24" />
                      </Button>
                      <Image Width="24" Height="24" Stretch="UniformToFill" Source="{Binding ZkillmailCard.Victim.ShipBitmap}" IsVisible="{Binding ZkillmailCard.Victim.HasShipBitmap}" ToolTip.Tip="{Binding ZkillmailCard.Victim.ShipDisplayName}" />
                      <Border Width="24" Height="24" Background="#172234" BorderBrush="#2A3C58" BorderThickness="1" IsVisible="{Binding ZkillmailCard.Victim.HasNoShipBitmap}" ToolTip.Tip="{Binding ZkillmailCard.Victim.ShipDisplayName}">
                        <TextBlock Text="?" Foreground="#BFD8FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Button Width="24" Height="24" Padding="0" Background="#202F43" BorderThickness="0" Click="OnZkillVictimPortraitClicked" ToolTip.Tip="{Binding ZkillmailCard.Victim.Name}">
                        <Grid>
                          <Image Width="24" Height="24" Stretch="UniformToFill" Source="{Binding ZkillmailCard.Victim.PortraitBitmap}" IsVisible="{Binding ZkillmailCard.Victim.HasPortraitBitmap}" />
                          <TextBlock Text="{Binding ZkillmailCard.Victim.PortraitFallbackText}" Foreground="#DDEAFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ZkillmailCard.Victim.HasNoPortraitBitmap}" />
                        </Grid>
                      </Button>
                      <Button Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Click="OnZkillVictimCorporationClicked" IsVisible="{Binding ZkillmailCard.Victim.HasCorporation}" ToolTip.Tip="{Binding ZkillmailCard.Victim.CorporationTicker}">
                        <Image Width="24" Height="24" Stretch="UniformToFill" Source="{Binding ZkillmailCard.Victim.CorporationBitmap}" />
                      </Button>
                      <Button Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Click="OnZkillVictimAllianceClicked" IsVisible="{Binding ZkillmailCard.Victim.HasAlliance}" ToolTip.Tip="{Binding ZkillmailCard.Victim.AllianceTicker}">
                        <Image Width="24" Height="24" Stretch="UniformToFill" Source="{Binding ZkillmailCard.Victim.AllianceBitmap}" />
                      </Button>
                      <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ZkillmailCard.Victim.Name}" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ZkillmailCard.Victim.MembershipTickerSummary}" Foreground="#9DB8D8" FontSize="8" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding ZkillmailCard.VisibleAttackers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#1A2639" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="4" Padding="3,2" Margin="0,0,0,2">
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <Image Width="20" Height="20" Stretch="UniformToFill" Source="{Binding ShipBitmap}" IsVisible="{Binding HasShipBitmap}" ToolTip.Tip="{Binding ShipDisplayName}" />
                            <Border Width="20" Height="20" Background="#172234" BorderBrush="#2A3C58" BorderThickness="1" IsVisible="{Binding HasNoShipBitmap}" ToolTip.Tip="{Binding ShipDisplayName}">
                              <TextBlock Text="?" Foreground="#BFD8FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Width="20" Height="20" Padding="0" Background="#202F43" BorderThickness="0" Click="OnIntelHostilePortraitClicked" ToolTip.Tip="{Binding Name}">
                              <Grid>
                                <Image Width="20" Height="20" Stretch="UniformToFill" Source="{Binding PortraitBitmap}" IsVisible="{Binding HasPortraitBitmap}" />
                                <TextBlock Text="{Binding PortraitFallbackText}" Foreground="#DDEAFF" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoPortraitBitmap}" />
                              </Grid>
                            </Button>
                            <Button Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0" Click="OnIntelHostileCorporationClicked" IsVisible="{Binding HasCorporation}" ToolTip.Tip="{Binding CorporationTicker}">
                              <Image Width="20" Height="20" Stretch="UniformToFill" Source="{Binding CorporationBitmap}" />
                            </Button>
                            <Button Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0" Click="OnIntelHostileAllianceClicked" IsVisible="{Binding HasAlliance}" ToolTip.Tip="{Binding AllianceTicker}">
                              <Image Width="20" Height="20" Stretch="UniformToFill" Source="{Binding AllianceBitmap}" />
                            </Button>
                            <StackPanel Spacing="0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" Foreground="#EAF2FF" FontSize="9" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding MembershipTickerSummary}" Foreground="#9DB8D8" FontSize="8" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border HorizontalAlignment="Left" Background="#241C35" BorderBrush="#5D83B5" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,0,2" IsVisible="{Binding ZkillmailCard.HasHiddenAttackers}">
                    <TextBlock Text="{Binding ZkillmailCard.HiddenAttackersSummary}" Foreground="#BFD8FF" FontSize="9" FontWeight="Bold" />
                  </Border>
                  <!-- <TextBlock Text="{Binding ZkillmailCard.MessageText, StringFormat='Report: {0}'}" Foreground="#E4ECF8" FontSize="10" TextWrapping="Wrap" /> -->
                </StackPanel>
              </Border>
            </Grid>
            <Grid ColumnDefinitions="4,*" IsVisible="{Binding IsMiningSiteAlert}">
              <Border Grid.Column="0" Background="{Binding MiningSiteAccentHex}" CornerRadius="5,0,0,5" />
              <Border Grid.Column="1" Padding="8,7" Background="#E012211B" BorderBrush="{Binding MiningSiteAccentHex}" BorderThickness="1" CornerRadius="0,7,7,0">
                <Grid ColumnDefinitions="42,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                  <Border Grid.RowSpan="2" Width="38" Height="38" Background="{Binding MiningSiteAccentBackgroundHex}" BorderBrush="{Binding MiningSiteAccentHex}" BorderThickness="1" CornerRadius="6" Padding="4">
                    <Image Source="{Binding MiningSiteIcon}" Stretch="Uniform" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding MiningSiteLabel}" Foreground="{Binding MiningSiteAccentHex}" FontSize="9" FontWeight="Bold" />
                    <TextBlock Text="{Binding MiningSiteSystemName}" Foreground="#F0FFF5" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Grid.Column="2" Padding="5,1" CornerRadius="4" BorderBrush="#5D83B5" BorderThickness="1" VerticalAlignment="Top" IsVisible="{Binding HasJumpCount}" ToolTip.Tip="{Binding JumpCountTooltip}">
                    <Border.Background>#192838</Border.Background>
                    <TextBlock Text="{Binding JumpCountLabel}" Foreground="#BFD8FF" FontSize="9" FontWeight="Bold" />
                  </Border>
                  <Border Grid.Column="3" Background="{Binding MiningSiteAccentBackgroundHex}" BorderBrush="{Binding MiningSiteAccentHex}" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Top">
                    <TextBlock Text="{Binding TimestampLabel}" Foreground="#FFF4C8" FontSize="9" FontWeight="Bold" />
                  </Border>
                  <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding MiningSiteUpgradeLabel}" Foreground="#D4E8DB" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
            <Grid ColumnDefinitions="4,*" IsVisible="{Binding HasEnvironmentalCard}">
              <Border Grid.Column="0" Background="{Binding EnvironmentalCard.AccentHex}" CornerRadius="5,0,0,5" />
              <Border Grid.Column="1" Padding="8,7" Background="#E012211B" BorderBrush="{Binding EnvironmentalCard.AccentHex}" BorderThickness="1" CornerRadius="0,7,7,0">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding EnvironmentalCard.CategoryLabel}" Foreground="{Binding EnvironmentalCard.AccentHex}" FontSize="9" FontWeight="Bold" />
                      <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ClickMode="Press" Click="OnEnvironmentalCardSystemClicked">
                        <TextBlock Foreground="#F0FFF5" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding EnvironmentalCard.SystemName}" />
                          <Run Text=" | " Foreground="#7F779C" />
                          <Run Text="{Binding EnvironmentalCard.RegionName}" FontSize="9" FontWeight="SemiBold" />
                        </TextBlock>
                      </Button>
                    </StackPanel>
                    <Border Grid.Column="1" Padding="5,1" CornerRadius="4" BorderBrush="#5D83B5" BorderThickness="1" VerticalAlignment="Top" IsVisible="{Binding HasJumpCount}" ToolTip.Tip="{Binding JumpCountTooltip}">
                      <Border.Background>#192838</Border.Background>
                      <TextBlock Text="{Binding JumpCountLabel}" Foreground="#BFD8FF" FontSize="9" FontWeight="Bold" />
                    </Border>
                    <Border Grid.Column="2" Background="{Binding EnvironmentalCard.AccentBackgroundHex}" BorderBrush="{Binding EnvironmentalCard.AccentHex}" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Top">
                      <TextBlock Text="{Binding EnvironmentalCard.TimestampLabel}" Foreground="#FFF4C8" FontSize="9" FontWeight="Bold" />
                    </Border>
                  </Grid>
                  <TextBlock Grid.Row="1" Text="{Binding EnvironmentalCard.Headline}" Foreground="#D4E8DB" FontSize="10" FontWeight="SemiBold" />
                  <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock Text="{Binding EnvironmentalCard.DetailOne}" Foreground="#BFD8FF" FontSize="9" />
                    <TextBlock Text="{Binding EnvironmentalCard.DetailTwo}" Foreground="#BFD8FF" FontSize="9" />
                    <TextBlock Text="{Binding EnvironmentalCard.DetailThree}" Foreground="#FFF4C8" FontSize="9" FontWeight="SemiBold" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
            <Border IsVisible="{Binding HasGenericAlert}" Padding="6" Background="#182434" BorderBrush="#364D6D" BorderThickness="1" CornerRadius="6">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                  <TextBlock Text="{Binding Title}" Foreground="#F1E8FF" FontSize="10" FontWeight="Bold"/>
                  <Border Grid.Column="1" Padding="5,1" CornerRadius="4" BorderBrush="#5D83B5" BorderThickness="1" IsVisible="{Binding HasJumpCount}" ToolTip.Tip="{Binding JumpCountTooltip}">
                    <Border.Background>#192838</Border.Background>
                    <TextBlock Text="{Binding JumpCountLabel}" Foreground="#BFD8FF" FontSize="9" FontWeight="Bold" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding Details}" Foreground="#E4ECF8" FontSize="10" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding TimestampLabel}" Foreground="#BFD8FF" FontSize="9" FontWeight="Bold"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</Window>
