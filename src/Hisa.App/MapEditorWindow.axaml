<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Hisa.App"
        xmlns:rendering="clr-namespace:Hisa.Rendering.Controls;assembly=Hisa.Rendering"
        mc:Ignorable="d"
        d:DesignWidth="1400"
        d:DesignHeight="900"
        x:Class="Hisa.App.MapEditorWindow"
        x:DataType="vm:MapEditorViewModel"
        Title="HISA Map Editor"
        Background="#0D131D">
  <Window.Styles>
    <Style Selector="Border.editor-card">
      <Setter Property="Background" Value="#141D2B" />
      <Setter Property="BorderBrush" Value="#263244" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="TextBlock.editor-section-title">
      <Setter Property="Foreground" Value="#D8E5F8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.editor-muted">
      <Setter Property="Foreground" Value="#8A96A8" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.editor-compact">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="10" Background="#121A26" BorderBrush="#263244" BorderThickness="0,0,0,1">
      <TextBlock Text="Map Editor" FontSize="16" FontWeight="SemiBold" Foreground="#D8E5F8" />
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="300,*">
      <Border Grid.Column="0" BorderBrush="#263244" BorderThickness="0,0,1,0" Padding="8" Background="#101826">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">
            <Border Classes="editor-card">
              <StackPanel Spacing="6">
                <TextBlock Classes="editor-section-title" Text="Custom Layout Region" />
                <TextBox Text="{Binding NewRegionName}" Watermark="New custom region name..." />
                <Button Classes="editor-compact" Content="Create Region" Click="OnCreateCustomRegionClicked" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <Button Classes="editor-compact" Grid.Column="0" Content="Export Selected" Click="OnExportSelectedRegionClicked" />
                  <Button Classes="editor-compact" Grid.Column="1" Content="Import JSON" Click="OnImportRegionJsonClicked" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="editor-card">
              <StackPanel Spacing="6">
                <TextBlock Classes="editor-section-title" Text="Layout Regions" />
                <ListBox x:Name="LayoutRegionsList"
                         ItemsSource="{Binding LayoutRegions}"
                         SelectedItem="{Binding SelectedLayoutRegion, Mode=TwoWay}"
                         SelectionChanged="OnLayoutRegionsSelectionChanged"
                         MinHeight="120"
                         MaxHeight="160" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <Button Classes="editor-compact"
                          Grid.Column="0"
                          Content="Rename"
                          Click="OnRenameLayoutRegionClicked"
                          IsEnabled="{Binding IsSelectedLayoutRegionEditable}" />
                  <Button Classes="editor-compact"
                          Grid.Column="1"
                          Content="Delete"
                          Click="OnDeleteLayoutRegionClicked"
                          IsEnabled="{Binding IsSelectedLayoutRegionEditable}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="editor-card">
              <StackPanel Spacing="6">
                <TextBlock Classes="editor-section-title" Text="Import Game Regions" />
                <TextBlock Classes="editor-muted" Text="Multi-select regions to append into the selected custom layout." TextWrapping="Wrap" />
                <ListBox x:Name="GameRegionsList"
                         ItemsSource="{Binding GameRegions}"
                         SelectionMode="Multiple"
                         MinHeight="150"
                         MaxHeight="210" />
                <Button Classes="editor-compact"
                        Content="Import Selected"
                        Click="OnImportGameRegionsClicked"
                        IsEnabled="{Binding IsSelectedLayoutRegionEditable}" />
              </StackPanel>
            </Border>

            <Border Classes="editor-card">
              <StackPanel Spacing="6">
                <TextBlock Classes="editor-section-title" Text="Map Actions" />
                <TextBlock Classes="editor-muted" Text="{Binding SelectionStatus}" />
                <CheckBox IsChecked="{Binding ShowEditorRegionLabel}" Content="Show Region Label" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                  <Button Classes="editor-compact" Grid.Row="0" Grid.Column="0" Content="Fit View" Click="OnFitViewClicked" />
                  <Button Classes="editor-compact" Grid.Row="0" Grid.Column="1" Content="Save Region" Click="OnSaveCurrentRegionClicked" IsEnabled="{Binding IsSelectedLayoutRegionEditable}" />
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Classes="editor-muted"
                       Text="Mouse: left-drag selected nodes (snap), Alt for free move, Ctrl+click add, Shift+drag box select, right/middle drag pan, wheel zoom."
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1">
        <rendering:MapControl x:Name="EditorMapControl"
                              Graph="{Binding CurrentGraph}"
                              ViewMode="Region"
                              StretchToWindow="False"
                              ShowEditorGrid="True"
                              ShowEditorRegionLabel="{Binding ShowEditorRegionLabel}"
                              EditorGridStep="0.01"
                              MinZoom="0.10"
                              MaxZoomOverride="12.0"
                              AllowFitBeyondMinZoom="True"
                              UseBuiltInSelection="False"
                              SelectedNodeId="{Binding SelectedNodeId, Mode=TwoWay}"
                              AdditionalSelectedNodeIds="{Binding SelectedNodeIdsForView}"
                              MissingConnectionNodeIds="{Binding MissingConnectionNodeIdsForView}"
                              CrossRegionConnectorNodeIds="{Binding CrossRegionConnectorNodeIdsForView}"
                              PointerPressed="OnEditorMapPointerPressed"
                              PointerMoved="OnEditorMapPointerMoved"
                              PointerReleased="OnEditorMapPointerReleased"
                              PointerWheelChanged="OnEditorMapPointerWheelChanged"
                              KeyDown="OnEditorMapKeyDown"
                              SizeChanged="OnEditorMapSizeChanged" />
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="10"
                Width="22"
                Height="22"
                Padding="0"
                ZIndex="20"
                CornerRadius="11"
                Background="#2A3A52"
                BorderBrush="#5D83B5"
                BorderThickness="1"
                Foreground="#EAF2FF"
                FontWeight="Bold"
                FontSize="12"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="?"
                ToolTip.ShowDelay="80"
                ToolTip.Placement="Bottom">
          <ToolTip.Tip>
            <Border Background="#111926"
                    BorderBrush="#2B3C55"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8"
                    MaxWidth="280">
              <StackPanel Spacing="4">
                <TextBlock Text="Map Legend"
                           Foreground="#D8E5F8"
                           FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="10" Height="10" Fill="#8E74D8" VerticalAlignment="Center" />
                  <TextBlock Text="Cross-region connector"
                             Foreground="#C7D6EA"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Canvas Width="16" Height="16">
                    <Ellipse Width="12" Height="12"
                             Stroke="#C567D6"
                             StrokeThickness="1.5"
                             StrokeDashArray="1.2,2.4"
                             Canvas.Left="2"
                             Canvas.Top="2" />
                  </Canvas>
                  <TextBlock Text="Has hidden links outside current map"
                             Foreground="#C7D6EA"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="18" Height="2" Background="#4D6FA2" VerticalAlignment="Center" />
                  <TextBlock Text="Link: same constellation"
                             Foreground="#C7D6EA"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="18" Height="2" Background="#3E8A7E" VerticalAlignment="Center" />
                  <TextBlock Text="Link: same region, different constellation"
                             Foreground="#C7D6EA"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="18" Height="2" Background="#8E5C8A" VerticalAlignment="Center" />
                  <TextBlock Text="Link: across regions"
                             Foreground="#C7D6EA"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>
          </ToolTip.Tip>
        </Button>
        <Canvas IsHitTestVisible="False">
          <Border x:Name="SelectionRect"
                  IsVisible="False"
                  BorderBrush="#88A5C7F0"
                  BorderThickness="1"
                  Background="#223A6EA8" />
        </Canvas>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Padding="8" Background="#121A26">
      <TextBlock Text="{Binding StatusText}" Foreground="#8A96A8" />
    </Border>
  </Grid>
</Window>
