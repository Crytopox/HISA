<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Hisa.App"
        xmlns:converters="clr-namespace:Hisa.App.Converters"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="420"
        x:Class="Hisa.App.PreferencesWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Preferences"
        Background="#0D131D">
  <Window.Resources>
    <converters:HubWormholeMarkerModeDisplayConverter x:Key="HubWormholeMarkerModeDisplayConverter" />
  </Window.Resources>
  <Border Margin="12" Padding="12" Background="#121A26" BorderBrush="#263244" BorderThickness="1" CornerRadius="6">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <TextBlock Text="Map Preferences" FontSize="15" FontWeight="SemiBold" Foreground="#D8E5F8" />

        <Border Padding="10" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="5">
          <StackPanel Spacing="6">
            <TextBlock Text="Layout" FontWeight="SemiBold" Foreground="#C9D9EE" />
            <CheckBox IsChecked="{Binding StretchMapToWindow}" Content="Stretch map to window" />
            <TextBlock Text="Off keeps 1:1 node spacing and avoids shape distortion when resizing."
                       Foreground="#8A96A8"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Padding="10" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="5">
          <StackPanel Spacing="6">
            <TextBlock Text="Connection Markers" FontWeight="SemiBold" Foreground="#C9D9EE" />
            <CheckBox IsChecked="{Binding ShowMissingConnectionMarkers}" Content="Show missing connection markers (region view)" />
            <TextBlock Text="Draws a dotted ring on systems with hidden SDE links outside the current map."
                       Foreground="#8A96A8"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Padding="10" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="5">
          <StackPanel Spacing="6">
            <TextBlock Text="Wormholes" FontWeight="SemiBold" Foreground="#C9D9EE" />
            <CheckBox IsChecked="{Binding AlwaysShowHubWormholes}" Content="Always show Thera/Turnur wormholes" />
            <TextBlock Text="Shows a corner marker independent of map color and icon filters."
                       Foreground="#8A96A8"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding AlwaysShowHubWormholes}">
              <TextBlock VerticalAlignment="Center" Text="Marker style" Foreground="#8A96A8" />
              <ComboBox Width="160"
                        ItemsSource="{Binding HubWormholeMarkerModes}"
                        SelectedItem="{Binding HubWormholeMarkerMode}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource HubWormholeMarkerModeDisplayConverter}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Border Padding="4,3" Background="#0D1522" BorderBrush="#2B3C55" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                <Grid Width="44" Height="20">
                  <Grid IsVisible="{Binding IsWormholePreviewBadge}">
                    <Ellipse Width="10" Height="10" Fill="#93A8C0" Stroke="#1A2536" StrokeThickness="1.0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <Border Background="#6BC1B5" BorderBrush="#0D131D" BorderThickness="1" CornerRadius="2"
                            Padding="2,0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,-6,0,0">
                      <TextBlock Text="T" FontSize="7" FontWeight="SemiBold" Foreground="#0D131D" />
                    </Border>
                  </Grid>
                  <Grid IsVisible="{Binding IsWormholePreviewRing}">
                    <Ellipse Width="10" Height="10" Fill="#93A8C0" Stroke="#1A2536" StrokeThickness="1.0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <Ellipse Width="15" Height="15" Stroke="#6BC1B5" StrokeThickness="1.6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                  </Grid>
                  <Grid IsVisible="{Binding IsWormholePreviewHalo}">
                    <Ellipse Width="15" Height="15" Fill="#4C6BC1B5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                    <Ellipse Width="10" Height="10" Fill="#93A8C0" Stroke="#1A2536" StrokeThickness="1.0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" />
                  </Grid>
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Padding="10" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="5">
          <StackPanel Spacing="6">
            <TextBlock Text="Incursions" FontWeight="SemiBold" Foreground="#C9D9EE" />
            <CheckBox IsChecked="{Binding AlwaysShowIncursions}" Content="Always show active incursion systems" />
            <TextBlock Text="Shows an incursion badge independent of map color and icon filters."
                       Foreground="#8A96A8"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Padding="10" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="5">
          <StackPanel Spacing="6">
            <TextBlock Text="Link Animation" FontWeight="SemiBold" Foreground="#C9D9EE" />
            <CheckBox IsChecked="{Binding EnableLinkAnimations}" Content="Enable animated link effects" />
            <CheckBox IsChecked="{Binding EnableIntelReportAnimations}" Content="Enable animated intel ship rings" />
            <TextBlock Text="Adds animated hover/selection effects on links (small performance impact on dense maps)."
                       Foreground="#8A96A8"
                       TextWrapping="Wrap" />
            <TextBlock Text="When disabled, intel ship icons on hostile rings stay static to reduce map redraw cost."
                       Foreground="#8A96A8"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Padding="10" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="5">
          <StackPanel Spacing="6">
            <TextBlock Text="zKillmails" FontWeight="SemiBold" Foreground="#C9D9EE" />
            <CheckBox IsChecked="{Binding HideZkillmailsOutsideKnownSpace}" Content="Hide killmails outside k-space" />
            <TextBlock Text="When enabled, zKill history, alerts, and hover data exclude systems outside known space such as wormhole space, Pochven, Thera, and Turnur."
                       Foreground="#8A96A8"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Padding="10" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="5">
          <StackPanel Spacing="6">
            <TextBlock Text="Local Logs Path" FontWeight="SemiBold" Foreground="#C9D9EE" />
            <TextBlock Text="EVE logs root folder (contains ChatLogs, GameLogs, FleetLogs, MarketLogs)."
                       Foreground="#8A96A8"
                       TextWrapping="Wrap" />
            <TextBox Text="{Binding LogsRootPath, Mode=TwoWay}" Watermark="C:\Users\username\Documents\EVE\logs" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Browse..." Click="OnBrowseLogsRootPathClicked" />
              <Button Content="Validate" Click="OnValidateLogsRootPathClicked" />
              <Button Content="Save" Click="OnSaveLogsRootPathClicked" />
            </StackPanel>
            <TextBlock Text="{Binding LogsPathValidationStatus}" Foreground="#A9BDD7" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
