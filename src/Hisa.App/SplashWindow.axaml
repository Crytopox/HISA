<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hisa.App.SplashWindow"
        Width="800"
        Height="450"
        Icon="avares://HISA/Assets/HISA-Logo.ico"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="#0D131D"
        ShowInTaskbar="False"
        Topmost="True">
  <Border BorderBrush="#263244" BorderThickness="1" CornerRadius="6" Background="#121A26">
    <Grid>
      <Image Source="avares://HISA/Assets/SplashScreen.png"
             Stretch="UniformToFill" />
      <Border VerticalAlignment="Bottom"
              Background="#9A0D131D"
              Padding="14,10">
        <TextBlock Text="Loading HISA..."
                   Foreground="#D8E5F8"
                   FontSize="14" />
      </Border>
    </Grid>
  </Border>
</Window>
