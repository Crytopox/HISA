<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="420"
        x:Class="Hisa.App.AlertPopupSettingsWindow"
        Title="Alert Popup Settings"
        MinWidth="500"
        MinHeight="400"
        Width="520"
        Height="420"
        Background="#0D131D">
  <Border Margin="10" Padding="10" Background="#121A26" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="8">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock Grid.Row="0" Text="Popup Behavior" Foreground="#EAF2FF" FontWeight="SemiBold"/>
      <StackPanel Grid.Row="1" Margin="0,8,0,8" Spacing="8">
        <Border Background="#0F1624" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="6" Padding="8">
          <StackPanel Spacing="4">
            <TextBlock x:Name="PlacementStatusTextBlock" Text="Placement mode: Off" Foreground="#DDE7F8" FontWeight="SemiBold"/>
            <TextBlock Text="Click 'Start Placement', drag the popup to where you want it, then click 'Stop Placement'. Offsets update automatically." TextWrapping="Wrap" Foreground="#9DB8D8" FontSize="11"/>
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="10">
          <CheckBox Grid.Column="0" x:Name="PopupEnabledCheckBox" Content="Enable Popup" Foreground="#DDE7F8"/>
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="Max Cards" Foreground="#9DB8D8"/>
            <TextBox x:Name="PopupMaxCardsTextBox" Width="90" Watermark="8"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="3">
            <TextBlock Text="Auto-dismiss (s)" Foreground="#9DB8D8"/>
            <TextBox x:Name="PopupAutoDismissTextBox" Width="110" Watermark="18"/>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
          <StackPanel Grid.Column="0" Spacing="3">
            <TextBlock Text="Popup Width" Foreground="#9DB8D8"/>
            <TextBox x:Name="PopupWidthTextBox" Width="90" Watermark="250"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="Popup Height" Foreground="#9DB8D8"/>
            <TextBox x:Name="PopupHeightTextBox" Width="90" Watermark="320"/>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
          <StackPanel Grid.Column="0" Spacing="3">
            <TextBlock Text="Opacity" Foreground="#9DB8D8"/>
            <Slider x:Name="PopupOpacitySlider" Minimum="20" Maximum="100" Value="95"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="Anchor" Foreground="#9DB8D8"/>
            <ComboBox x:Name="PopupAnchorComboBox" Width="140"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="3">
            <TextBlock Text="Offset X" Foreground="#9DB8D8"/>
            <TextBox x:Name="PopupOffsetXTextBox" Width="90" Watermark="12"/>
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="3">
            <TextBlock Text="Offset Y" Foreground="#9DB8D8"/>
            <TextBox x:Name="PopupOffsetYTextBox" Width="90" Watermark="56"/>
          </StackPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
        <Button Grid.Column="0" Content="Save" MinWidth="86" Click="OnSaveClicked"/>
        <Button Grid.Column="1" x:Name="PlacementToggleButton" Content="Start Placement" MinWidth="130" Click="OnPlacementToggleClicked"/>
        <Button Grid.Column="2" Content="Close" MinWidth="86" Click="OnCloseClicked"/>
      </Grid>
    </Grid>
  </Border>
</Window>
