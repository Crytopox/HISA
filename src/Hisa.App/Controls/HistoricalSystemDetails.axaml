<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Hisa.Core;assembly=Hisa.Core"
             xmlns:intel="clr-namespace:Hisa.Core.Models.Intelligence;assembly=Hisa.Core"
             xmlns:rendering="clr-namespace:Hisa.Rendering.Controls;assembly=Hisa.Rendering"
             x:Class="Hisa.App.Controls.HistoricalSystemDetails" x:DataType="core:HistoricalActivityFeature">
  <Border Background="#F0101826" BorderBrush="#586B88" BorderThickness="1" CornerRadius="6" Padding="8">
    <Expander Header="Historical system details" IsExpanded="True" Foreground="#E3D5B4" FontSize="12">
      <ScrollViewer MaxHeight="390" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" Margin="0,6,0,0">
          <TextBlock Text="{Binding ContextNote}" Foreground="#ACB8CA" FontSize="10" TextWrapping="Wrap" />
          <Expander Header="Combat findings" IsExpanded="True" IsVisible="{Binding Combat.IsEnabled}" Foreground="#E3D5B4">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding Combat.Status}" Foreground="#ACB8CA" FontSize="10" TextWrapping="Wrap" />
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding Combat.IsLoading}" Height="2" />
              <ListBox ItemsSource="{Binding Combat.Events}" SelectedItem="{Binding Combat.SelectedEvent, Mode=TwoWay}" MaxHeight="150">
                <ListBox.ItemTemplate><DataTemplate x:DataType="intel:CombatEngagement">
                  <TextBlock Text="{Binding Display}" FontSize="10" TextWrapping="Wrap" />
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button Content="Refresh findings" Command="{Binding Combat.RefreshCommand}" FontSize="10" Padding="5,3" />
                <Button Content="Next page" Command="{Binding Combat.NextPageCommand}" IsEnabled="{Binding Combat.HasNextPage}" FontSize="10" Padding="5,3" />
                <Button Content="Focus system" Command="{Binding Combat.FocusCommand}" FontSize="10" Padding="5,3" />
              </WrapPanel>
              <TextBlock Text="{Binding Combat.Detail}" Foreground="#DFE8F5" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsDetailLoading}" Height="2" />
          <TextBlock Text="{Binding DetailText}" Foreground="#DFE8F5" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="Recorded killmails · timeline (UTC, log height)" Foreground="#ACB8CA" FontSize="10" />
          <rendering:HistoricalTimelineControl Bins="{Binding Timeline}" Height="52" />
          <TextBlock Text="Up to 96 display intervals; blue baseline means no recorded event, not guaranteed inactivity." Foreground="#ACB8CA" FontSize="10" TextWrapping="Wrap" />
          <Button Content="Load leading ship losses" Command="{Binding LoadShipsCommand}" IsEnabled="{Binding CanLoadShips}" Padding="8,4" FontSize="11" />
          <TextBlock Text="{Binding ShipStatus}" Foreground="#ACB8CA" FontSize="10" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Ships}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="intel:HistoricalShipLoss">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2"><TextBlock Text="{Binding Name}" Foreground="#DFE8F5" FontSize="11" />
                <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="#F3DBA8" FontSize="11" /></Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Expander>
  </Border>
</UserControl>
