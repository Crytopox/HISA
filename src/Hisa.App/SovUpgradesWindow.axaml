<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:Hisa.App"
        mc:Ignorable="d"
        x:Class="Hisa.App.SovUpgradesWindow"
        Width="860"
        Height="820"
        Title="SOV Upgrades"
        Background="#0D131D">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="12">
    <TextBlock Text="SOV Upgrades" Foreground="#D8E5F8" FontSize="16" FontWeight="SemiBold" />
    <Border Grid.Row="1" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Import mode" VerticalAlignment="Center" Foreground="#8A96A8" />
          <ComboBox x:Name="ImportModeCombo" Width="190" SelectedIndex="0">
            <ComboBoxItem Content="Delete Previous (Default)" />
            <ComboBoxItem Content="Update on Change" />
            <ComboBoxItem Content="Append" />
          </ComboBox>
          <Button Content="Import / Apply" Click="OnImportClicked" />
        </StackPanel>
        <TextBlock Text="Paste Input" Foreground="#8A96A8" />
        <TextBox x:Name="ImportTextBox"
                 Watermark="Supported: RIFT SOV upgrades format (SYSTEM &lt;- Upgrade 3, Upgrade 2)&#10;Example: 1-PGSG &lt;- Major Threat Detection Array 3, Exploration Detector 3"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalAlignment="Stretch"
                 Height="96" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="Manual Add / Update" Foreground="#8A96A8" />
        <Grid ColumnDefinitions="140,230,80,Auto" ColumnSpacing="6">
          <TextBox Grid.Column="0" x:Name="ManualSystemBox" Watermark="System" />
          <ComboBox Grid.Column="1" x:Name="ManualUpgradeCombo" />
          <ComboBox Grid.Column="2" x:Name="ManualTierCombo" SelectedIndex="0">
            <ComboBoxItem Content="T1" />
            <ComboBoxItem Content="T2" />
            <ComboBoxItem Content="T3" />
          </ComboBox>
          <Button Grid.Column="3" Content="Add / Update" Click="OnAddManualClicked" />
        </Grid>
        <Grid ColumnDefinitions="180,Auto" ColumnSpacing="6">
          <TextBox Grid.Column="0" x:Name="RemoveSystemBox" Watermark="System to remove" />
          <Button Grid.Column="1" Content="Remove System" Click="OnRemoveSystemClicked" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0" VerticalAlignment="Stretch">
      <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Unique Upgrades" Foreground="#8A96A8" VerticalAlignment="Center" />
          <TextBlock x:Name="UniqueUpgradeHeaderCount" Text="0" Foreground="#D8E5F8" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="UniqueUpgradesEmpty" Text="No upgrades saved." Foreground="#8A96A8" Margin="0,8,0,0" />
        <ScrollViewer Grid.Row="2" x:Name="UniqueUpgradeCountsHost" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
          <ItemsControl x:Name="UniqueUpgradeCounts">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="app:SovUpgradeCountGroup">
                <StackPanel Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                    <TextBlock Text="{Binding Title}" Foreground="#D8E5F8" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Count}" Foreground="#9DB1CC" VerticalAlignment="Center" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Upgrades}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="app:SovUpgradeCountRow">
                        <Border Padding="6,4" Margin="2" BorderThickness="1" BorderBrush="#2B3C55" CornerRadius="4" Background="#172234">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Source="{Binding Icon}" Width="16" Height="16" />
                            <TextBlock Text="{Binding DisplayName}" Foreground="#D8E5F8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Count}" Foreground="#9DB1CC" VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <TextBlock Grid.Row="4" Text="Saved Upgrades" Foreground="#8A96A8" Margin="0,10,0,6" />
    <Border Grid.Row="5" Background="#101826" BorderBrush="#243247" BorderThickness="1" CornerRadius="4" Padding="6">
      <ListBox x:Name="SavedUpgradesList" Height="140" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="app:SovUpgradeListRow">
            <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
              <TextBlock Text="{Binding SystemName}" Foreground="#D8E5F8" VerticalAlignment="Center" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Upgrades}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:SovSystemUpgradeChip">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1,10,1">
                      <Image Source="{Binding Icon}" Width="14" Height="14" />
                      <TextBlock Text="{Binding Label}" Foreground="#D8E5F8" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <TextBlock x:Name="StatusText" Grid.Row="6" Foreground="#8A96A8" Margin="0,8,0,0" TextWrapping="Wrap" />
  </Grid>
</Window>
